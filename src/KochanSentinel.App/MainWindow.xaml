<ui:FluentWindow x:Class="KochanSentinel.App.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:KochanSentinel.App.Controls"
                 xmlns:views="clr-namespace:KochanSentinel.App.Views"
                 Title="KOCHAN Sentinel"
                 Width="1260"
                 Height="800"
                 MinWidth="1020"
                 MinHeight="600"
                 Background="#09090B"
                 WindowStartupLocation="CenterScreen"
                 WindowBackdropType="None"
                 ExtendsContentIntoTitleBar="True"
                 PreviewKeyDown="Window_PreviewKeyDown"
                 Closing="MainWindow_Closing">

    <Grid Background="#09090B">
        <Grid.RowDefinitions>
            <RowDefinition Height="32" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="28" />
        </Grid.RowDefinitions>

        <!-- TitleBar -->
        <ui:TitleBar Grid.Row="0" Title="KOCHAN Sentinel — Sistem Performans &amp; Güvenlik Merkezi" Height="32" Padding="10,0" Background="#09090B" />

        <!-- Global One-Click Auto-Update Banner (Appears automatically when a new GitHub Release is available) -->
        <Border Grid.Row="1" Background="#052E16" BorderBrush="#166534" BorderThickness="0,0,0,1" Padding="14,8"
                Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,14,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoRefresh}" Stroke="#4ADE80" Width="13" Height="13" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding UpdateBannerText}" Foreground="#ECFDF5" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </StackPanel>
                    <ProgressBar Value="{Binding UpdateProgressPercent, Mode=OneWay}" Maximum="100" Height="4" Margin="0,6,0,0" Foreground="#4ADE80"
                                 Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Sürüm Notları" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,4" Margin="0,0,6,0"
                            Command="{Binding ShowUpdateReleaseNotesCommand}" />
                    <Button Content="⚡ Şimdi Güncelle (Otomatik)" Padding="12,4" Margin="0,0,6,0"
                            Command="{Binding InstallAvailableUpdateCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource ShadcnPrimaryBtn}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDownloadingUpdate}" Value="True">
                                        <Setter Property="IsEnabled" Value="False" />
                                        <Setter Property="Content" Value="İndiriliyor..." />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="✕" Foreground="#86EFAC" Background="Transparent" BorderThickness="0" Padding="6,2" Cursor="Hand"
                            Command="{Binding DismissUpdateBannerCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Body: Left Sidebar + Content -->
        <Grid Grid.Row="2" Margin="12,6,12,6">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="236" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar (shadcn Zinc-950) -->
            <Border Grid.Column="0" Background="#111113" CornerRadius="8" Padding="10" Margin="0,0,12,0" BorderBrush="#27272A" BorderThickness="1">
                <Border.Resources>
                    <Style x:Key="NavRadioStyle" TargetType="RadioButton">
                        <Setter Property="Foreground" Value="#A1A1AA" />
                        <Setter Property="FontSize" Value="12.5" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="Margin" Value="0,1" />
                        <Setter Property="GroupName" Value="MainNav" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="RadioButton">
                                    <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Padding="0,6,8,6">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="4" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border x:Name="Indicator" Grid.Column="0" Width="3" Height="15" CornerRadius="2"
                                                    Background="#FAFAFA" Visibility="Collapsed" VerticalAlignment="Center" />
                                            <ContentPresenter Grid.Column="1" Margin="9,0,0,0" VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#18181B" />
                                            <Setter Property="Foreground" Value="#FAFAFA" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bg" Property="Background" Value="#18181B" />
                                            <Setter TargetName="Indicator" Property="Visibility" Value="Visible" />
                                            <Setter Property="Foreground" Value="#FAFAFA" />
                                            <Setter Property="FontWeight" Value="SemiBold" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                    <Style x:Key="NavCategoryStyle" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="10" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                        <Setter Property="Foreground" Value="#71717A" />
                        <Setter Property="Margin" Value="8,9,0,3" />
                    </Style>
                </Border.Resources>

                <DockPanel>
                    <!-- Brand & Logo Header Card (Linear/Vercel style) -->
                    <Border DockPanel.Dock="Top" Background="#18181B" CornerRadius="8" Padding="9,8" Margin="2,0,2,8" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="32" Height="32" CornerRadius="7" ClipToBounds="True" BorderBrush="#27272A" BorderThickness="1">
                                    <Image Source="/Assets/logo.png" Stretch="UniformToFill" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="9,0,6,0" VerticalAlignment="Center">
                                    <TextBlock Text="KOCHAN" FontSize="14" FontWeight="Bold" Foreground="#FAFAFA" />
                                    <TextBlock Text="SENTINEL GUARD" FontSize="9" Foreground="#71717A" FontWeight="SemiBold" Margin="0,1,0,0" />
                                </StackPanel>
                                <Border Grid.Column="2" Background="#09090B" CornerRadius="5" Padding="6,2" VerticalAlignment="Top" BorderBrush="#27272A" BorderThickness="1">
                                    <TextBlock Text="{Binding AppVersionText}" FontSize="9.5" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                </Border>
                            </Grid>

                            <!-- Full-width Privilege Strip -->
                            <Border Background="#111113" CornerRadius="6" Padding="8,4" Margin="0,7,0,0" BorderBrush="#27272A" BorderThickness="1"
                                    Visibility="{Binding Metrics.IsElevated, Converter={StaticResource InvBoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#71717A" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Grid.Column="1" Text="Standart Mod" Foreground="#A1A1AA" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Path Grid.Column="2" Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoLock}" Width="11" Height="11" Stroke="#71717A" />
                                </Grid>
                            </Border>
                            <Border Background="#062815" CornerRadius="6" Padding="8,4" Margin="0,7,0,0" BorderBrush="#14532D" BorderThickness="1"
                                    Visibility="{Binding Metrics.IsElevated, Converter={StaticResource BoolToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Grid.Column="0" Width="6" Height="6" Fill="#22C55E" VerticalAlignment="Center" Margin="0,0,7,0" />
                                    <TextBlock Grid.Column="1" Text="Yönetici İzni Modu" Foreground="#86EFAC" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    <Path Grid.Column="2" Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoShield}" Width="11" Height="11" Stroke="#4ADE80" />
                                </Grid>
                            </Border>

                            <!-- Command Palette Trigger (Ctrl+K) -->
                            <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,6,0,0" Padding="8,4" HorizontalContentAlignment="Stretch"
                                    Command="{Binding OpenCommandPaletteCommand}" ToolTip="Tüm araçlara ve sayfalara hızlı erişim (Ctrl + K)">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoSearch}" Width="11" Height="11" Stroke="#71717A" Margin="0,0,6,0" />
                                    <TextBlock Grid.Column="1" Text="Hızlı Ara..." Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" />
                                    <Border Grid.Column="2" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                        <TextBlock Text="Ctrl+K" Foreground="#71717A" FontSize="9.5" FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Border>

                    <!-- Bottom Compact Health Card (never clips nav items on small screens) -->
                    <Border DockPanel.Dock="Bottom" Background="#18181B" CornerRadius="8" Padding="10,9" Margin="2,8,2,0" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0" Width="52" Height="52" VerticalAlignment="Center" Margin="0,0,10,0">
                                <ui:ProgressRing Progress="{Binding Metrics.HealthScore, Mode=OneWay}" IsIndeterminate="False"
                                                 Width="52" Height="52" Foreground="{Binding Metrics.HealthScore, Converter={StaticResource HealthToBrush}}" />
                                <TextBlock Text="{Binding Metrics.HealthScore}" FontSize="16" FontWeight="Bold" Foreground="#FAFAFA"
                                           VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock Text="Sistem Sağlığı" FontSize="10.5" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                <TextBlock Text="{Binding Metrics.HealthStatusText}" FontSize="11.5"
                                           Foreground="{Binding Metrics.HealthScore, Converter={StaticResource HealthToBrush}}" FontWeight="SemiBold"
                                           Margin="0,2,0,2" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding LastScanLabel}" FontSize="9.5" Foreground="#71717A" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Scrollable Categorized Nav Items -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly" Focusable="False" Padding="0,0,2,0">
                        <StackPanel>
                            <TextBlock Text="İZLEME" Style="{StaticResource NavCategoryStyle}" Margin="8,2,0,3" />
                            <RadioButton x:Name="NavRadioDashboard" Style="{StaticResource NavRadioStyle}" Tag="0" IsChecked="True" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Home24" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Genel Bakış" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavRadioMonitor" Style="{StaticResource NavRadioStyle}" Tag="1" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Pulse24" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Canlı Monitör" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="OPTİMİZASYON" Style="{StaticResource NavCategoryStyle}" />
                            <RadioButton x:Name="NavRadioCleaner" Style="{StaticResource NavRadioStyle}" Tag="2" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Broom24" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Temizlik &amp; RAM" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavRadioDisk" Style="{StaticResource NavRadioStyle}" Tag="7" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,5 A2,2 0 0 1 4,3 H9 L11,5 H20 A2,2 0 0 1 22,7 V19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 Z"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,11,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" />
                                    <TextBlock Text="Disk Analizi" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavRadioGames" Style="{StaticResource NavRadioStyle}" Tag="3" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Games24" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Oyun Merkezi" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavRadioBenchmark" Style="{StaticResource NavRadioStyle}" Tag="6" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,13 H6.5 V21 H3 Z M10.2,6 H13.7 V21 H10.2 Z M17.5,2 H21 V21 H17.5 Z"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,11,0"
                                          Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" />
                                    <TextBlock Text="Sistem Benchmark" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavRadioStudio" Style="{StaticResource NavRadioStyle}" Tag="8" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M2,4 H22 V16 H2 Z M8,20 H16 M12,16 V20"
                                          Width="15" Height="15" Stretch="Uniform" VerticalAlignment="Center" Margin="0,0,11,0"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.8" />
                                    <TextBlock Text="Ekran, Sürücü &amp; Servis" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>

                            <TextBlock Text="SİSTEM &amp; KORUMA" Style="{StaticResource NavCategoryStyle}" />
                            <RadioButton x:Name="NavRadioSecurity" Style="{StaticResource NavRadioStyle}" Tag="4" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="ShieldCheckmark24" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Güvenlik &amp; Kalıntı" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="NavRadioSettings" Style="{StaticResource NavRadioStyle}" Tag="5" Checked="NavRadio_Checked">
                                <StackPanel Orientation="Horizontal">
                                    <ui:SymbolIcon Symbol="Settings24" FontSize="16" Margin="0,0,10,0" />
                                    <TextBlock Text="Ayarlar" VerticalAlignment="Center" />
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- Content Panels -->
            <Grid Grid.Column="1">
                <!-- TAB 0: DASHBOARD -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" x:Name="TabDashboard">
                    <StackPanel Margin="0,0,2,0">
                        <!-- Top Hero Banner -->
                        <Border Background="#111113" CornerRadius="8" Padding="18" BorderBrush="#27272A" BorderThickness="1" Margin="0,0,0,12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Sistem Özeti &amp; Hızlı Kontrol" FontSize="19" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Foreground="#A1A1AA" FontSize="12.5" Margin="0,4,0,0">
                                        <Run Text="İşlemci: " /><Run Text="{Binding Metrics.CpuName}" Foreground="#E4E4E7" />
                                        <Run Text="  |  GPU: " /><Run Text="{Binding Metrics.GpuName}" Foreground="#E4E4E7" />
                                    </TextBlock>
                                    <TextBlock Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,0">
                                        <Run Text="Güç Planı: " /><Run Text="{Binding Metrics.ActivePowerPlan}" Foreground="#FAFAFA" FontWeight="SemiBold" />
                                        <Run Text="  |  CPU Sıcaklık: " /><Run Text="{Binding Metrics.CpuTempCelsius, TargetNullValue=--, StringFormat={}{0:F0}°C}" Foreground="#FBBF24" FontWeight="SemiBold" />
                                        <Run Text="  |  GPU: " /><Run Text="{Binding Metrics.GpuTempCelsius, TargetNullValue=--, StringFormat={}{0:F0}°C}" Foreground="#C084FC" FontWeight="SemiBold" />
                                        <Run Text=" (" /><Run Text="{Binding Metrics.GpuLoadPercent, TargetNullValue=0, StringFormat={}{0:F0}%}" Foreground="#C084FC" /><Run Text=")" />
                                        <Run Text="  |  FPS: " /><Run Text="{Binding Metrics.CurrentFps, TargetNullValue=--}" Foreground="#4ADE80" FontWeight="SemiBold" />
                                        <Run Text="  |  Fan: " /><Run Text="{Binding Metrics.FanRpm, TargetNullValue=--, StringFormat={}{0} RPM}" Foreground="#A1A1AA" />
                                        <Run Text="  |  Boot: " /><Run Text="{Binding BootPerformance.LastBootSeconds, TargetNullValue=--, StringFormat={}{0:F1} sn}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                        <Run Text="  |  Süre: " /><Run Text="{Binding Metrics.Uptime, StringFormat={}{0:hh\\:mm\\:ss}}" Foreground="#E4E4E7" />
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ShadcnSecondaryBtn}"
                                            Height="38" Padding="12,0" Margin="0,0,8,0" Click="ExportHtmlReport_Click"
                                            ToolTip="Donanım, sıcaklık, benchmark ve güvenlik durumunu tek HTML raporu olarak kaydet">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoHistory}" Stroke="#38BDF8" Margin="0,0,6,0" />
                                            <TextBlock Text="HTML Rapor" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ShadcnSecondaryBtn}"
                                            Height="38" Padding="12,0" Margin="0,0,8,0" Click="ToggleMiniHud_Click"
                                            ToolTip="Monitörünün köşesine yerleştirebileceğin mini CPU/RAM/FPS/Ağ göstergesini aç/kapat">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoPin}" Stroke="#FAFAFA" Margin="0,0,6,0" />
                                            <TextBlock Text="Mini HUD" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ShadcnPrimaryBtn}"
                                            Height="38" Padding="16,0" FontSize="13.5" Command="{Binding QuickBoostCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoZap}" Stroke="#09090B" Fill="#09090B" Margin="0,0,7,0" />
                                            <TextBlock Text="Tek Tıkla Hızlandır" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- 4 Live Telemetry Cards (Clickable + Real-time Sparklines) -->
                        <UniformGrid Columns="4" Margin="0,0,0,12">
                            <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="#27272A" BorderThickness="1"
                                    Cursor="Hand" Tag="CPU" MouseLeftButtonUp="TelemetryCard_Click" ToolTip="Tıkla: En çok CPU kullanan işlemleri gör">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="CPU KULLANIMI" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                        <TextBlock Text="Detay →" FontSize="10.5" Foreground="#71717A" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Metrics.CpuUsagePercent, StringFormat={}{0:F1}%}" FontSize="26" FontWeight="Bold"
                                               Foreground="{Binding Metrics.CpuUsagePercent, Converter={StaticResource PercentToBrush}}" Margin="0,4,0,2" />
                                    <controls:SparklineControl Values="{Binding CpuHistory}" StrokeBrush="#FBBF24" MaxValue="100" Height="28" Margin="0,2,0,6" />
                                    <ProgressBar Value="{Binding Metrics.CpuUsagePercent, Mode=OneWay}" Maximum="100" Height="4" Foreground="#FBBF24" />
                                    <TextBlock Text="{Binding Metrics.CpuLogicalProcessors, StringFormat={}{0} Mantıksal Çekirdek}" FontSize="11" Foreground="#71717A" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="16" Margin="4,0,4,0" BorderBrush="#27272A" BorderThickness="1"
                                    Cursor="Hand" Tag="RAM" MouseLeftButtonUp="TelemetryCard_Click" ToolTip="Tıkla: En çok RAM kullanan işlemleri gör">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="RAM BELLEK" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                        <TextBlock Text="Detay →" FontSize="10.5" Foreground="#71717A" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Metrics.RamUsagePercent, StringFormat={}{0:F0}%}" FontSize="26" FontWeight="Bold"
                                               Foreground="{Binding Metrics.RamUsagePercent, Converter={StaticResource PercentToBrush}}" Margin="0,4,0,2" />
                                    <controls:SparklineControl Values="{Binding RamHistory}" StrokeBrush="#38BDF8" MaxValue="100" Height="28" Margin="0,2,0,6" />
                                    <ProgressBar Value="{Binding Metrics.RamUsagePercent, Mode=OneWay}" Maximum="100" Height="4" Foreground="#38BDF8" />
                                    <TextBlock FontSize="11" Foreground="#71717A" Margin="0,6,0,0">
                                        <Run Text="{Binding Metrics.RamUsedGb, StringFormat={}{0:F1} GB}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F1} GB}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="16" Margin="4,0,4,0" BorderBrush="#27272A" BorderThickness="1"
                                    Cursor="Hand" Tag="Disk" MouseLeftButtonUp="TelemetryCard_Click" ToolTip="Tıkla: En çok Disk kullanan işlemleri gör">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="DİSK AKTİVİTESİ" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                        <TextBlock Text="Detay →" FontSize="10.5" Foreground="#71717A" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Metrics.DiskUsagePercent, StringFormat={}{0:F0}%}" FontSize="26" FontWeight="Bold"
                                               Foreground="{Binding Metrics.DiskUsagePercent, Converter={StaticResource PercentToBrush}}" Margin="0,4,0,2" />
                                    <Border Height="28" Margin="0,2,0,6">
                                        <TextBlock Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center">
                                            <Run Text="Okuma: " /><Run Text="{Binding Metrics.DiskReadMbps, StringFormat={}{0:F1} MB/s}" Foreground="#FAFAFA" FontWeight="SemiBold" />
                                            <LineBreak />
                                            <Run Text="Yazma: " /><Run Text="{Binding Metrics.DiskWriteMbps, StringFormat={}{0:F1} MB/s}" Foreground="#E4E4E7" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </Border>
                                    <ProgressBar Value="{Binding Metrics.DiskUsagePercent, Mode=OneWay}" Maximum="100" Height="4" Foreground="#C084FC" />
                                    <TextBlock Text="{Binding Metrics.ActiveProcessCount, StringFormat={}{0} Aktif Süreç}" FontSize="11" Foreground="#71717A" Margin="0,6,0,0" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="16" Margin="8,0,0,0" BorderBrush="#27272A" BorderThickness="1"
                                    Cursor="Hand" Tag="Network" MouseLeftButtonUp="TelemetryCard_Click" ToolTip="Tıkla: Aktif ağ bağlantısı kullanan işlemleri gör">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock Text="AĞ TRAFİĞİ" FontSize="11" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                        <TextBlock Text="Detay →" FontSize="10.5" Foreground="#71717A" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                    </DockPanel>
                                    <TextBlock Text="{Binding Metrics.NetworkDownloadMbps, StringFormat={}{0:F1} Mbps}" FontSize="22" FontWeight="Bold" Foreground="#4ADE80" Margin="0,6,0,4" />
                                    <controls:SparklineControl Values="{Binding NetHistory}" StrokeBrush="#4ADE80" AutoScale="True" Height="28" Margin="0,2,0,6" />
                                    <TextBlock Text="{Binding Metrics.NetworkUploadMbps, StringFormat=↑ Gönderme: {0:F1} Mbps}" FontSize="11.5" Foreground="#A78BFA" />
                                    <TextBlock FontSize="10.5" Foreground="#A1A1AA" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="Ping: " /><Run Text="{Binding Metrics.PingMs, TargetNullValue=--, StringFormat={}{0} ms}" Foreground="#4ADE80" FontWeight="SemiBold" />
                                        <Run Text=" • Jitter: " /><Run Text="{Binding Metrics.PingJitterMs, StringFormat={}{0:F1} ms}" Foreground="#E4E4E7" />
                                        <Run Text=" • Kayıp: %" /><Run Text="{Binding Metrics.PacketLossPercent, StringFormat={}{0:F0}}" Foreground="#FBBF24" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding Metrics.ActiveNetworkAdapter}" FontSize="10.5" Foreground="#71717A" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Drives & Recent Events -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1*" />
                                <ColumnDefinition Width="1.4*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,8,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Disk Sürücüleri &amp; S.M.A.R.T. Sağlığı" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,10" />
                                    <ItemsControl ItemsSource="{Binding Metrics.Drives}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Margin="0,0,0,10">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                        <TextBlock Text="{Binding Label, StringFormat= ({0})}" Foreground="#A1A1AA" />
                                                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right" Foreground="#D4D4D8" FontSize="12">
                                                            <Run Text="{Binding FreeGb, StringFormat={}{0:F1} GB boş}" />
                                                            <Run Text=" / " />
                                                            <Run Text="{Binding TotalGb, StringFormat={}{0:F0} GB}" />
                                                        </TextBlock>
                                                    </DockPanel>
                                                    <ProgressBar Value="{Binding UsedPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <ItemsControl ItemsSource="{Binding Metrics.SmartDrives}" Margin="0,4,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#18181B" CornerRadius="6" Padding="8,6" Margin="0,3,0,0" BorderBrush="#27272A" BorderThickness="1">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="#E4E4E7" FontSize="11.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" MaxWidth="160" ToolTip="{Binding Name}" />
                                                        <Border Background="#3F1518" CornerRadius="4" Padding="5,1" Margin="6,0,0,0" Visibility="{Binding PredictFailure, Converter={StaticResource BoolToVis}}">
                                                            <TextBlock Text="ARIZA RİSKİ" Foreground="#FCA5A5" FontSize="9.5" FontWeight="Bold" />
                                                        </Border>
                                                        <TextBlock Text="{Binding SummaryText}" Foreground="#A1A1AA" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#111113" CornerRadius="8" Padding="16" Margin="4,0,0,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Son Sistem &amp; Güvenlik Olayları" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,10" />
                                    <ListBox ItemsSource="{Binding SecurityEvents}" MaxHeight="190" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,3">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Ellipse Grid.Column="0" Width="7" Height="7" Fill="{Binding Severity, Converter={StaticResource SeverityToBrush}}" Margin="0,5,8,0" VerticalAlignment="Top" />
                                                    <TextBlock Grid.Column="1" Text="{Binding TimeText}" Foreground="#71717A" FontSize="11.5" Margin="0,0,8,0" />
                                                    <TextBlock Grid.Column="2" Text="{Binding Source, StringFormat=[{0}]}" Foreground="#E4E4E7" FontSize="11.5" FontWeight="SemiBold" Margin="0,0,6,0" />
                                                    <TextBlock Grid.Column="3" Text="{Binding Message}" Foreground="#A1A1AA" FontSize="11.5" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Top Resource Consumers Widget -->
                        <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,12,0,0" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoActivity}" Stroke="#FBBF24" Margin="0,0,8,0" />
                                        <TextBlock Text="En Çok Kaynak Tüketenler (Anlık)" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    </StackPanel>
                                    <TextBlock Text="Sistemi yoran uygulamaları buradan tek tıkla Verimlilik Moduna alabilir veya kapatabilirsin."
                                               Foreground="#71717A" FontSize="11.5" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding TopConsumers}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" CornerRadius="6" Padding="12,8" Margin="0,3" BorderBrush="#27272A" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="1.6*" />
                                                        <ColumnDefinition Width="1*" />
                                                        <ColumnDefinition Width="0.8*" />
                                                        <ColumnDefinition Width="0.9*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Description}" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12.5" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Name, StringFormat={}{0}.exe}" Foreground="#71717A" FontSize="11" />
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="1" Text="{Binding Category}" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="2" Text="{Binding CpuPercent, StringFormat=CPU: {0:F1}%}" Foreground="#FBBF24" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" />
                                                    <TextBlock Grid.Column="3" Text="{Binding RamMb, StringFormat=RAM: {0:F0} MB}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12.5" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="4" Orientation="Horizontal">
                                                        <Button Content="Eco Mod" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,4" Margin="0,0,6,0" ToolTip="Verimlilik Moduna Al"
                                                                Command="{Binding DataContext.EcoModeProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                        <Button Content="Kapat" Style="{StaticResource ShadcnDangerBtn}" Padding="10,4" ToolTip="İşlemi Sonlandır"
                                                                Command="{Binding DataContext.KillProcessCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 1: LIVE PROCESSES & NETWORK SHIELD -->
                <Grid x:Name="TabProcesses" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Segmented Top Switcher -->
                    <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" HorizontalAlignment="Left" Background="#18181B" CornerRadius="8" Padding="3" BorderBrush="#27272A" BorderThickness="1">
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton Content="Süreç Monitörü" Style="{StaticResource ShadcnSegmentedTab}" GroupName="ProcSub" Tag="0" IsChecked="True" Checked="ProcessesSubTab_Checked" />
                                        <RadioButton Content="Ağ Kalkanı &amp; GeoIP" Style="{StaticResource ShadcnSegmentedTab}" GroupName="ProcSub" Tag="1" Checked="ProcessesSubTab_Checked" />
                                        <RadioButton Content="Engellenen Uygulamalar" Style="{StaticResource ShadcnSegmentedTab}" GroupName="ProcSub" Tag="2" Checked="ProcessesSubTab_Checked" />
                                        <RadioButton Content="DNS Önbelleği" Style="{StaticResource ShadcnSegmentedTab}" GroupName="ProcSub" Tag="3" Checked="ProcessesSubTab_Checked" />
                                        <RadioButton Content="Güvenli DNS (DoH)" Style="{StaticResource ShadcnSegmentedTab}" GroupName="ProcSub" Tag="4" Checked="ProcessesSubTab_Checked" />
                                    </WrapPanel>
                                </Border>
                                <Button x:Name="BtnRefreshNetShield" Grid.Column="1" Style="{StaticResource ShadcnSecondaryBtn}" Margin="10,0,0,0"
                                        VerticalAlignment="Center" Visibility="Collapsed" Command="{Binding ScanNetworkShieldCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoRefresh}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                        <TextBlock Text="Ağ &amp; DNS Yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <Border x:Name="NetShieldSummaryBar" Visibility="Collapsed" Background="#18181B" CornerRadius="6" Padding="10,6" Margin="0,8,0,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoGlobe}" Stroke="#38BDF8" Width="12.5" Height="12.5" Margin="0,0,8,0" />
                                    <TextBlock Text="{Binding NetShieldSummary}" Foreground="#D4D4D8" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Sub-Panel 0: Process Monitor -->
                    <Grid x:Name="PanelProcTable" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="14" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <ui:TextBox PlaceholderText="İşlem ara (örn: chrome, discord, steam)..." Width="260"
                                                Text="{Binding ProcessSearchQuery, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Eco" Style="{StaticResource ShadcnSecondaryBtn}" Margin="3,0" ToolTip="Verimlilik Modu (EcoQoS)" Command="{Binding EcoModeProcessCommand}" />
                                        <Button Content="Askıya Al" Style="{StaticResource ShadcnSecondaryBtn}" Margin="3,0" Command="{Binding SuspendProcessCommand}" />
                                        <Button Content="Devam" Style="{StaticResource ShadcnSecondaryBtn}" Margin="3,0" Command="{Binding ResumeProcessCommand}" />
                                        <Button Content="Konum" Style="{StaticResource ShadcnSecondaryBtn}" Margin="3,0" ToolTip="Dosya konumunu Explorer'da aç" Command="{Binding OpenProcessLocationCommand}" />
                                        <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="3,0" ToolTip="Windows Güvenlik Duvarından giden bağlantıyı engelle" Command="{Binding BlockProcessFirewallCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoBan}" Stroke="#FCA5A5" Width="12" Height="12" Margin="0,0,5,0" />
                                                <TextBlock Text="İnternet Kes" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="3,0" ToolTip="Firewall internet engelini kaldır" Command="{Binding UnblockProcessFirewallCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoGlobe}" Stroke="#86EFAC" Width="12" Height="12" Margin="0,0,5,0" />
                                                <TextBlock Text="Engeli Kaldır" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="Sonlandır" Style="{StaticResource ShadcnDangerBtn}" Margin="3,0,0,0" Command="{Binding KillProcessCommand}" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Filtre:" Foreground="#71717A" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <RadioButton Content="Tümü" Style="{StaticResource ShadcnFilterChip}" IsChecked="True" Command="{Binding SetProcessCategoryFilterCommand}" CommandParameter="Tümü" />
                                        <RadioButton Content="İmzasızlar" Style="{StaticResource ShadcnFilterChip}" Command="{Binding SetProcessCategoryFilterCommand}" CommandParameter="İmzasızlar" />
                                        <RadioButton Content="Firewall Engelliler" Style="{StaticResource ShadcnFilterChip}" Command="{Binding SetProcessCategoryFilterCommand}" CommandParameter="Engelli" />
                                        <RadioButton Content="Tarayıcılar" Style="{StaticResource ShadcnFilterChip}" Command="{Binding SetProcessCategoryFilterCommand}" CommandParameter="Tarayıcı" />
                                        <RadioButton Content="Oyunlar" Style="{StaticResource ShadcnFilterChip}" Command="{Binding SetProcessCategoryFilterCommand}" CommandParameter="Oyun" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding ProcessSortTitle}" Foreground="#A1A1AA" FontWeight="SemiBold" FontSize="11.5" DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                                <DockPanel>
                                    <WrapPanel Orientation="Horizontal">
                                        <TextBlock Text="Sırala:" Foreground="#71717A" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <Button Content="CPU %" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,5" Margin="0,0,6,0" Command="{Binding SetProcessSortModeCommand}" CommandParameter="CPU" />
                                        <Button Content="RAM (MB)" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,5" Margin="0,0,6,0" Command="{Binding SetProcessSortModeCommand}" CommandParameter="RAM" />
                                        <Button Content="Disk (KB/s)" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,5" Margin="0,0,6,0" Command="{Binding SetProcessSortModeCommand}" CommandParameter="Disk" />
                                        <Button Content="Ağ Bağlantıları" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,5" Command="{Binding SetProcessSortModeCommand}" CommandParameter="Network" />
                                    </WrapPanel>
                                    <CheckBox Content="Sadece Aktif Kullananlar (0 gizle)" Style="{StaticResource ShadcnCheckBox}"
                                              IsChecked="{Binding ShowOnlyActiveConsumers}"
                                              DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                </DockPanel>
                            </StackPanel>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding Processes}" SelectedItem="{Binding SelectedProcess}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Background="#111113" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                            <DataGrid.ContextMenu>
                                <ContextMenu Background="#18181B" Foreground="#FAFAFA" BorderBrush="#3F3F46">
                                    <MenuItem Header="⚡ Verimlilik Modu (EcoQoS)" Command="{Binding EcoModeProcessCommand}" />
                                    <MenuItem Header="⏸ Askıya Al (Dondur)" Command="{Binding SuspendProcessCommand}" />
                                    <MenuItem Header="▶ Devam Ettir" Command="{Binding ResumeProcessCommand}" />
                                    <Separator />
                                    <MenuItem Header="⚙ Öncelik Ayarla">
                                        <MenuItem Header="Yüksek (High)" Command="{Binding SetProcessPriorityCommand}" CommandParameter="High" />
                                        <MenuItem Header="Normalin Üstünde" Command="{Binding SetProcessPriorityCommand}" CommandParameter="AboveNormal" />
                                        <MenuItem Header="Normal" Command="{Binding SetProcessPriorityCommand}" CommandParameter="Normal" />
                                        <MenuItem Header="Normalin Altında" Command="{Binding SetProcessPriorityCommand}" CommandParameter="BelowNormal" />
                                        <MenuItem Header="Düşük (Idle)" Command="{Binding SetProcessPriorityCommand}" CommandParameter="Idle" />
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Header="🛡️ Dosyayı EDR ile Tara" Command="{Binding ScanSelectedProcessExeCommand}" />
                                    <MenuItem Header="📁 Dosya Konumunu Aç" Command="{Binding OpenProcessLocationCommand}" />
                                    <MenuItem Header="🚫 Firewall İnternetini Kes" Command="{Binding BlockProcessFirewallCommand}" />
                                    <MenuItem Header="🌐 Firewall Engelini Kaldır" Command="{Binding UnblockProcessFirewallCommand}" />
                                    <Separator />
                                    <MenuItem Header="✕ İşlemi Sonlandır" Foreground="#FCA5A5" Command="{Binding KillProcessCommand}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="İşlem Adı" Width="155">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Grid VerticalAlignment="Center" ToolTip="{Binding ExecutablePath}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Name}" FontWeight="SemiBold" Foreground="#FAFAFA"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <Border Grid.Column="1" Background="#3F1518" BorderBrush="#7F1D1D" BorderThickness="1"
                                                        CornerRadius="4" Padding="4,1" Margin="6,0,0,0" VerticalAlignment="Center"
                                                        Visibility="{Binding IsFirewallBlocked, Converter={StaticResource BoolToVis}}">
                                                    <TextBlock Text="ENGEL" Foreground="#FCA5A5" FontSize="9" FontWeight="Bold" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Kategori" Width="115">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Background="{Binding Category, Converter={StaticResource CategoryToBrush}}" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" Margin="2">
                                                <TextBlock Text="{Binding Category}" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Güvenlik" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsSigned, Converter={StaticResource SignedToText}}"
                                                       Foreground="{Binding IsSigned, Converter={StaticResource SignedToBrush}}"
                                                       FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="CPU %" Width="68">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding CpuPercent, StringFormat={}{0:F1}%}" Foreground="#FBBF24" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="RAM" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RamMb, StringFormat={}{0:F0} MB}" Foreground="#38BDF8" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Grafik" Width="76">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Value="{Binding RamMb, Mode=OneWay}" Maximum="1500" Height="5" VerticalAlignment="Center" Margin="4,0" Foreground="#38BDF8" ToolTip="{Binding RamMb, StringFormat={}{0:F0} MB}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Disk" Width="85">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding DiskKbPerSec, StringFormat={}{0:F1} KB/s}" Foreground="#A78BFA" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ağ Hızı" Width="108">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding NetSpeedText}" Foreground="#4ADE80" FontWeight="SemiBold" FontSize="11.5" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Ağ" Width="44">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActiveConnections}" Foreground="#4ADE80" FontWeight="Bold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Uzak IP / Portlar" Width="170">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding RemoteEndpoints}" Foreground="#A1A1AA" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding RemoteEndpoints}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Açıklama" Width="*" MinWidth="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Description}" Foreground="#D4D4D8" VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <!-- Sub-Panel 1: Active Network Shield + GeoIP -->
                    <DataGrid x:Name="PanelNetShield" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding ExternalConnections}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="#111113" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="68" />
                            <DataGridTemplateColumn Header="Süreç" Width="155">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProcessName}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" ToolTip="{Binding ExecutablePath}" TextTrimming="CharacterEllipsis" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Uzak IP : Port" Binding="{Binding EndpointText}" Width="165" />
                            <DataGridTemplateColumn Header="Ülke / ISP (GeoIP)" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding CountryOrOrg}" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding CountryOrOrg}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Risk" Width="88">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding Severity, Converter={StaticResource SeverityToBgBrush}}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorderBrush}}" BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontSize="11" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Değerlendirme" Width="*" MinWidth="160">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Müdahale" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="İnternet Kes" Style="{StaticResource ShadcnDangerBtn}" Padding="8,3"
                                                Command="{Binding DataContext.BlockNetEntryFirewallCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Sub-Panel 2: Blocked Firewall Rules Management -->
                    <DataGrid x:Name="PanelFirewallRules" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding BlockedFirewallRules}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="#111113" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Firewall Kuralı" Binding="{Binding RuleName}" Width="240" />
                            <DataGridTemplateColumn Header="Engellenen Uygulama" Width="180">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProcessName}" Foreground="#FCA5A5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Program Konumu" Width="*" MinWidth="220">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding ProgramPath}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProgramPath}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="İşlem" Width="135">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="Engeli Kaldır" Style="{StaticResource ShadcnEmeraldBtn}" Padding="10,4"
                                                Command="{Binding DataContext.UnblockFirewallRuleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Sub-Panel 3: Live DNS Resolver Cache -->
                    <DataGrid x:Name="PanelDnsCache" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding DnsCacheEntries}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="#111113" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Alan Adı (Domain)" Width="280">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Domain}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Domain}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Tip" Binding="{Binding RecordType}" Width="90" />
                            <DataGridTemplateColumn Header="Çözümlenen Kayıt / IP" Width="*" MinWidth="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding RecordData}" Foreground="#38BDF8" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RecordData}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Durum" Width="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="6" Padding="7,2" HorizontalAlignment="Left" Background="#3F1518" BorderBrush="#7F1D1D" BorderThickness="1"
                                                Visibility="{Binding IsSuspicious, Converter={StaticResource BoolToVis}}">
                                            <TextBlock Text="ŞÜPHELİ TLD" Foreground="#FCA5A5" FontSize="10.5" FontWeight="Bold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Sub-Panel 4: One-Click Secure DNS (DoH) Switcher -->
                    <ScrollViewer x:Name="PanelDnsSwitcher" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Tek Tıkla Güvenli DNS &amp; Windows 11 DoH Değiştirici" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <TextBlock Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,0">
                                            <Run Text="Mevcut DNS Sunucuları: " /><Run Text="{Binding CurrentDnsText}" Foreground="#38BDF8" FontWeight="SemiBold" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="Bağdaştırıcı:" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Width="190" ItemsSource="{Binding ActiveNetworkAdapters}" SelectedItem="{Binding SelectedDnsAdapter}" Margin="0,0,8,0" />
                                        <Button Content="Yenile" Style="{StaticResource ShadcnSecondaryBtn}" Command="{Binding RefreshDnsAdaptersCommand}" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <ItemsControl ItemsSource="{Binding DnsProfiles}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#111113" CornerRadius="8" Padding="15" Margin="4" BorderBrush="#27272A" BorderThickness="1">
                                            <Grid>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="*" />
                                                    <RowDefinition Height="Auto" />
                                                </Grid.RowDefinitions>
                                                <StackPanel Grid.Row="0">
                                                    <DockPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontSize="14" FontWeight="SemiBold" />
                                                        <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="7,2" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                                            <TextBlock Text="{Binding ServersLabel}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Description}" Foreground="#A1A1AA" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,10" />
                                                </StackPanel>
                                                <Button Grid.Row="1" Content="Bu DNS Profilini Uygula &amp; Önbelleği Temizle" Style="{StaticResource ShadcnPrimaryBtn}"
                                                        HorizontalAlignment="Left"
                                                        Command="{Binding DataContext.ApplyDnsProfileCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- TAB 2: CLEANER, RAM & TWEAKS/REPAIR -->
                <Grid x:Name="TabCleaner" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Segmented Header -->
                    <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Background="#18181B" CornerRadius="8" Padding="3" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton Content="Çöp &amp; RAM Temizliği" Style="{StaticResource ShadcnSegmentedTab}" GroupName="CleanSub" Tag="0" IsChecked="True" Checked="CleanerSubTab_Checked" />
                                    <RadioButton Content="Sistem Tweaks &amp; Onarım (SFC / DISM)" Style="{StaticResource ShadcnSegmentedTab}" GroupName="CleanSub" Tag="1" Checked="CleanerSubTab_Checked" />
                                    <RadioButton Content="Başlangıç &amp; Boot Süresi" Style="{StaticResource ShadcnSegmentedTab}" GroupName="CleanSub" Tag="2" Checked="CleanerSubTab_Checked" />
                                </StackPanel>
                            </Border>
                            <TextBlock Grid.Column="1" Text="Otomatik Sistem Geri Yükleme sigortası Ayarlar'dan yönetilir." Foreground="#71717A" FontSize="11.5"
                                       HorizontalAlignment="Right" VerticalAlignment="Center" Margin="14,0,0,0" TextTrimming="CharacterEllipsis"
                                       ToolTip="Otomatik Sistem Geri Yükleme sigortası Ayarlar'dan yönetilir." />
                        </Grid>
                    </Border>

                    <!-- Sub-Panel 0: Junk & RAM Cleaner -->
                    <Grid x:Name="PanelCleanerMain" Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Top Action Bar -->
                        <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Akıllı RAM &amp; Çöp Dosya Temizliği" FontSize="17" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                <TextBlock Text="{Binding CleanerSummary}" Foreground="#A1A1AA" Margin="0,4,0,12" TextWrapping="Wrap" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,8,4" Command="{Binding ToggleSelectAllJunkCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoCheck}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="Tümünü Seç / Bırak" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,8,4" Command="{Binding ScanJunkCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoRefresh}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="Yeniden Tara" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ShadcnPrimaryBtn}" Margin="0,0,8,4" Command="{Binding CleanJunkCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoTrash}" Stroke="#09090B" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="Seçilenleri Temizle" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource ShadcnEmeraldBtn}" Margin="0,0,0,4" Command="{Binding OptimizeRamCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoZap}" Stroke="#86EFAC" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="RAM &amp; Standby Optimize Et" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </Border>

                        <!-- Live Animated Progress & Result Banner -->
                        <StackPanel Grid.Row="1" Margin="0,0,0,10">
                            <Border Background="#18181B" CornerRadius="8" Padding="14" BorderBrush="#3F3F46" BorderThickness="1"
                                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:ProgressRing IsIndeterminate="True" Width="26" Height="26" Margin="0,0,14,0" />
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="İşlem Devam Ediyor..." Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="13.5" />
                                        <TextBlock Text="{Binding CleanerLiveAction}" Foreground="#A1A1AA" FontSize="12" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <Border Background="#052E16" CornerRadius="8" Padding="14" BorderBrush="#166534" BorderThickness="1"
                                    Visibility="{Binding HasActionResult, Converter={StaticResource BoolToVis}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LastActionResultTitle}" Foreground="#86EFAC" FontWeight="Bold" FontSize="14.5" />
                                    <TextBlock Text="{Binding LastActionResultDetail}" Foreground="#D4D4D8" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Split: Left Categories | Right Live Activity Log -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.6*" />
                                <ColumnDefinition Width="1*" />
                            </Grid.ColumnDefinitions>

                            <ListBox Grid.Column="0" ItemsSource="{Binding JunkCategories}" Background="#111113" BorderBrush="#27272A" BorderThickness="1"
                                     Padding="8" Margin="0,0,10,0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     HorizontalContentAlignment="Stretch">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18181B" CornerRadius="8" Padding="12" Margin="0,4" BorderBrush="#27272A" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected}" Style="{StaticResource ShadcnCheckBox}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <StackPanel Grid.Column="1" Margin="0,0,12,0" MinWidth="0">
                                                    <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{Binding Description}" FontSize="12" Foreground="#A1A1AA" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding PathsSummary}" FontSize="10.5" Foreground="#71717A" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathsSummary}" />
                                                </StackPanel>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <StackPanel Margin="0,0,10,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding SizeFormatted}" FontSize="15" FontWeight="Bold" Foreground="#FAFAFA" HorizontalAlignment="Right" />
                                                        <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} dosya}" FontSize="11" Foreground="#71717A" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                    <Button Style="{StaticResource ShadcnSecondaryBtn}" ToolTip="Klasörü Aç" Padding="8,6"
                                                            Command="{Binding DataContext.OpenJunkFolderCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}">
                                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoFolder}" Stroke="#FAFAFA" Width="13" Height="13" />
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <Border Grid.Column="1" Background="#111113" CornerRadius="8" Padding="12" BorderBrush="#27272A" BorderThickness="1">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoHistory}" Stroke="#A1A1AA" Margin="0,0,7,0" />
                                        <TextBlock Text="Canlı İşlem Günlüğü" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding CleanerActivityLog}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>
                        </Grid>
                    </Grid>

                    <!-- Sub-Panel 1: Safe Windows Tweaks & SFC/DISM Repair -->
                    <Grid x:Name="PanelTweaksAndRepair" Grid.Row="1" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.25*" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,10,0" BorderBrush="#27272A" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Güvenli Oyuncu &amp; Gizlilik Ayarları (Tweaks)" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="Tüm ayarlar standart Windows Registry üzerinden çalışır; tek tıkla varsayılana geri döndürülebilir." Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                                <ListBox ItemsSource="{Binding SystemTweaks}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" CornerRadius="8" Padding="12" Margin="0,4" BorderBrush="#27272A" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                                            <Border Background="#27272A" CornerRadius="5" Padding="6,1" Margin="0,0,8,0">
                                                                <TextBlock Text="{Binding Category}" Foreground="#D4D4D8" FontSize="10" FontWeight="SemiBold" />
                                                            </Border>
                                                            <TextBlock Text="{Binding StatusBadge}" Foreground="#38BDF8" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontSize="13.5" FontWeight="SemiBold" />
                                                        <TextBlock Text="{Binding Description}" Foreground="#A1A1AA" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                                    </StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding ActionText}" Style="{StaticResource ShadcnSecondaryBtn}" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ToggleTweakCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                            CommandParameter="{Binding}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>

                        <Border Grid.Column="1" Background="#111113" CornerRadius="8" Padding="16" BorderBrush="#27272A" BorderThickness="1">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                                    <TextBlock Text="Windows Sistem Onarımı &amp; Yedek Sigortası" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="{Binding RepairStatusText}" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,10" TextWrapping="Wrap" />
                                    <WrapPanel Orientation="Horizontal">
                                        <Button Style="{StaticResource ShadcnEmeraldBtn}" Margin="0,0,8,6" Command="{Binding CreateRestorePointNowCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoShield}" Stroke="#86EFAC" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                                <TextBlock Text="Geri Yükleme Noktası Al" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                        <Button Content="SFC /scannow Başlat" Style="{StaticResource ShadcnPrimaryBtn}" Margin="0,0,8,6" Command="{Binding RunSfcCommand}" />
                                        <Button Content="DISM /RestoreHealth" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,8,6" Command="{Binding RunDismCommand}" />
                                        <Button Content="Durdur" Style="{StaticResource ShadcnDangerBtn}" Margin="0,0,0,6"
                                                Visibility="{Binding IsRepairRunning, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding CancelRepairCommand}" />
                                    </WrapPanel>
                                </StackPanel>
                                <Border Background="#09090B" CornerRadius="6" Padding="10" BorderBrush="#27272A" BorderThickness="1">
                                    <ListBox ItemsSource="{Binding RepairLogLines}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding}" Foreground="#D4D4D8" FontFamily="Consolas" FontSize="11" TextWrapping="Wrap" Margin="0,2" />
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </Border>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- Sub-Panel 2: Boot Time Performance & Non-Destructive Startup Manager -->
                    <Grid x:Name="PanelStartupManager" Grid.Row="1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,14,0">
                                    <TextBlock Text="Windows Açılış Süresi (Boot) &amp; Başlangıç Yöneticisi" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="{Binding BootPerformance.SummaryText}" Foreground="#38BDF8" FontSize="12.5" FontWeight="SemiBold" Margin="0,4,0,2" TextWrapping="Wrap" />
                                    <TextBlock Text="{Binding StartupManagerSummary}" Foreground="#A1A1AA" FontSize="11.5" TextWrapping="Wrap" />
                                </StackPanel>
                                <Button Grid.Column="1" Style="{StaticResource ShadcnPrimaryBtn}" VerticalAlignment="Center" Command="{Binding ScanStartupAppsCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoRefresh}" Stroke="#09090B" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                        <TextBlock Text="Başlangıç Listesini Yenile" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <DataGrid Grid.Row="1" ItemsSource="{Binding StartupApps}"
                                  AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                  ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                  Background="#111113" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                  GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="Durum" Width="92">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding StatusText}" Foreground="{Binding IsEnabled, Converter={StaticResource SignedToBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Uygulama" Binding="{Binding Name}" Width="180" />
                                <DataGridTextColumn Header="Kaynak" Binding="{Binding Source}" Width="125" />
                                <DataGridTextColumn Header="Açılış Etkisi" Binding="{Binding ImpactLevel}" Width="96" />
                                <DataGridTemplateColumn Header="İmza" Width="88">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding IsSigned, Converter={StaticResource SignedToText}}" Foreground="{Binding IsSigned, Converter={StaticResource SignedToBrush}}" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="Komut / Yol" Width="*" MinWidth="180">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Command}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Command}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Header="İşlem" Width="145">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button Content="{Binding ToggleButtonText}" Style="{StaticResource ShadcnSecondaryBtn}" Padding="9,3"
                                                    Command="{Binding DataContext.ToggleStartupAppCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </Grid>

                <!-- TAB 3: GAME CENTER & LIBRARY -->
                <ScrollViewer x:Name="TabGameMode" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,2,0">
                        <Border CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#111113" />
                                    <Setter Property="BorderBrush" Value="#27272A" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsGameBoostActive}" Value="True">
                                            <Setter Property="Background" Value="#052E16" />
                                            <Setter Property="BorderBrush" Value="#166534" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,16,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <TextBlock Text="KOCHAN Oyun Merkezi &amp; Boost" FontSize="18" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                        <Border CornerRadius="6" Padding="8,2" Margin="12,0,0,0" VerticalAlignment="Center" BorderThickness="1">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#18181B" />
                                                    <Setter Property="BorderBrush" Value="#27272A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsGameBoostActive}" Value="True">
                                                            <Setter Property="Background" Value="#14532D" />
                                                            <Setter Property="BorderBrush" Value="#22C55E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding GameModeBadgeText}" FontSize="11" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding ActiveGameLabel}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,4">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Foreground" Value="#A1A1AA" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsGameBoostActive}" Value="True">
                                                        <Setter Property="Foreground" Value="#86EFAC" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                    <TextBlock Text="Oyun açıldığında güç planını Yüksek Performansa alır, Standby RAM önbelleğini temizler ve gereksiz arka plan uygulamalarını uyutur."
                                               Foreground="#71717A" FontSize="12" TextWrapping="Wrap" />
                                </StackPanel>

                                <Button Grid.Column="1" Content="{Binding GameModeButtonText}" Command="{Binding ToggleManualGameModeCommand}"
                                        Height="40" Padding="18,0" FontSize="13" FontWeight="SemiBold" Cursor="Hand" VerticalAlignment="Center">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#FAFAFA" />
                                            <Setter Property="Foreground" Value="#09090B" />
                                            <Setter Property="BorderBrush" Value="#FAFAFA" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsGameBoostActive}" Value="True">
                                                    <Setter Property="Background" Value="#16A34A" />
                                                    <Setter Property="BorderBrush" Value="#22C55E" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Installed Games Library -->
                        <Border Background="#111113" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel>
                                        <TextBlock Text="Bilgisayarda Kurulu Oyunlar (Steam / Epic / Riot)" FontSize="15.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <TextBlock Text="{Binding GameLibrarySummary}" Foreground="#A1A1AA" FontSize="12" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Style="{StaticResource ShadcnSecondaryBtn}" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Command="{Binding ScanInstalledGamesCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoRefresh}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="Oyunları Yeniden Tara" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </DockPanel>

                                <ItemsControl ItemsSource="{Binding InstalledGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" CornerRadius="8" Padding="14" Margin="0,4" BorderBrush="#27272A" BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="8" Background="#111113" Margin="0,0,12,0" BorderBrush="#27272A" BorderThickness="1">
                                                        <Image Source="{Binding IconExePath, Converter={StaticResource ExeToIcon}}" Width="30" Height="30" RenderOptions.BitmapScalingMode="HighQuality" />
                                                    </Border>
                                                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                                                        <StackPanel Orientation="Horizontal">
                                                            <TextBlock Text="{Binding Name}" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                                            <Border Background="#172554" CornerRadius="6" Padding="7,2" Margin="10,0,0,0" VerticalAlignment="Center" BorderBrush="#1E40AF" BorderThickness="1">
                                                                <TextBlock Text="{Binding Platform}" FontSize="10" FontWeight="SemiBold" Foreground="#93C5FD" />
                                                            </Border>
                                                            <TextBlock Text="{Binding SizeFormatted}" Foreground="#A1A1AA" FontSize="12" Margin="10,0,0,0" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding InstallPath}" Foreground="#71717A" FontSize="11" Margin="0,3,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding InstallPath}" />
                                                        <TextBlock Text="{Binding VerifyStatus}" Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Button Style="{StaticResource ShadcnPrimaryBtn}" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.OptimizeAndLaunchGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoZap}" Stroke="#09090B" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                                                <TextBlock Text="Optimize &amp; Başlat" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0"
                                                                Command="{Binding DataContext.VerifyGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoShield}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                                                <TextBlock Text="Klasör Doğrula" VerticalAlignment="Center" />
                                                            </StackPanel>
                                                        </Button>
                                                        <Button Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,6" ToolTip="Oyun Klasörünü Aç"
                                                                Command="{Binding DataContext.OpenGameFolderCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                                CommandParameter="{Binding}">
                                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoFolder}" Stroke="#FAFAFA" Width="13" Height="13" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- Custom Games -->
                        <Border Background="#111113" CornerRadius="8" Padding="18" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Özel Oyun Listesi (Otomatik Algılama)" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,6" />
                                <TextBlock Text="Listede olmayan bir oyunun .exe adını (örn: metin2client.exe) ekleyebilirsiniz:" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,10" />
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                    <ui:TextBox Width="280" PlaceholderText="Oyun exe adı (örn: game.exe)" Text="{Binding NewGameExeName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                    <Button Content="+ Ekle" Style="{StaticResource ShadcnPrimaryBtn}" Command="{Binding AddCustomGameCommand}" />
                                </StackPanel>
                                <ItemsControl ItemsSource="{Binding CustomGames}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#18181B" CornerRadius="6" Padding="10,6" Margin="0,3" BorderBrush="#27272A" BorderThickness="1">
                                                <DockPanel>
                                                    <TextBlock Text="{Binding}" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                                    <Button Content="Sil" Style="{StaticResource ShadcnDangerBtn}" Padding="10,4" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                            Command="{Binding DataContext.RemoveCustomGameCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                            CommandParameter="{Binding}" />
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 4: SECURITY & LEFTOVER AUDIT -->
                <Grid x:Name="TabSecurity" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Shadcn-style Security Status Hero -->
                    <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="18" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Margin="0,0,14,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Background="#052E16" CornerRadius="6" Padding="8,2" BorderBrush="#166534" BorderThickness="1"
                                            Visibility="{Binding IsRealTimeShieldActive, Converter={StaticResource BoolToVis}}">
                                        <TextBlock Text="● EDR AKTİF SAVUNMA &amp; KALKAN AÇIK" Foreground="#86EFAC" FontSize="10.5" FontWeight="SemiBold" />
                                    </Border>
                                    <Border Background="#3F1518" CornerRadius="6" Padding="8,2" BorderBrush="#7F1D1D" BorderThickness="1"
                                            Visibility="{Binding IsRealTimeShieldActive, Converter={StaticResource InvBoolToVis}}">
                                        <TextBlock Text="○ GERÇEK ZAMANLI KALKAN KAPALI" Foreground="#FCA5A5" FontSize="10.5" FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Text="{Binding LastScanLabel}" Foreground="#71717A" FontSize="11.5" Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="{Binding SecurityHeroTitle}" FontSize="17.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                <TextBlock Text="{Binding SecurityHeroSubtitle}" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Style="{StaticResource ShadcnEmeraldBtn}" Margin="0,0,8,0" ToolTip="Müdahale öncesi Windows Sistem Geri Yükleme Noktası oluştur" Command="{Binding CreateRestorePointNowCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoShield}" Stroke="#86EFAC" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                        <TextBlock Text="Yedek Noktası Al" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ShadcnPrimaryBtn}" Margin="0,0,8,0" Command="{Binding RunPersistenceAuditCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoSearch}" Stroke="#09090B" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                        <TextBlock Text="Derin Tarama Başlat" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                <Button Style="{StaticResource ShadcnSecondaryBtn}" Click="BrowseAndScanFile_Click">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoFolder}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                        <TextBlock Text="Dosya Seç &amp; Tara" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- File Dropzone / Last Scan Result -->
                    <Border Grid.Row="1" Background="#111113" CornerRadius="8" Padding="12,10" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1"
                            AllowDrop="True" Drop="FileScanner_Drop">
                        <StackPanel>
                            <TextBlock Text="Şüpheli dosya taramak için buraya sürükleyip bırakabilirsin (.exe, .dll, .ps1, .bat)"
                                       Foreground="#71717A" FontSize="12" VerticalAlignment="Center" />
                            <Border Background="#18181B" CornerRadius="6" Padding="10" Margin="0,8,0,0" BorderBrush="#27272A" BorderThickness="1"
                                    Visibility="{Binding LastFileScan, Converter={StaticResource NotNullToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,12,0">
                                        <DockPanel>
                                            <TextBlock Text="{Binding LastFileScan.FileName}" FontSize="13.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                            <TextBlock Text="{Binding LastFileScan.Verdict}" FontSize="13" FontWeight="Bold"
                                                       Foreground="{Binding LastFileScan.RiskLevel, Converter={StaticResource SeverityToBrush}}"
                                                       DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <TextBlock Foreground="#A1A1AA" FontSize="11.5" Margin="0,3,0,0" TextTrimming="CharacterEllipsis">
                                            <Run Text="SHA-256: " /><Run Text="{Binding LastFileScan.Sha256}" Foreground="#E4E4E7" />
                                            <Run Text="  |  Entropi: " /><Run Text="{Binding LastFileScan.ShannonEntropy}" Foreground="#E4E4E7" />
                                            <Run Text="  |  Defender: " /><Run Text="{Binding LastFileScan.DefenderResult}" Foreground="#E4E4E7" />
                                            <Run Text="  |  Bulut: " /><Run Text="{Binding LastFileScan.CloudIntelResult}" Foreground="#E4E4E7" />
                                        </TextBlock>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource ShadcnDangerBtn}"
                                            Command="{Binding QuarantineLastScannedFileCommand}" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoLock}" Stroke="#FCA5A5" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="Karantinaya Al" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Segmented Panel: Findings vs Security History -->
                    <Border Grid.Row="2" Background="#111113" CornerRadius="8" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Margin="0,0,0,10">
                                <!-- shadcn Segmented Tabs List -->
                                <Border HorizontalAlignment="Left" Background="#18181B" CornerRadius="8" Padding="3" BorderBrush="#27272A" BorderThickness="1">
                                    <WrapPanel Orientation="Horizontal">
                                        <RadioButton x:Name="SecTabFindings" Content="Başlangıç &amp; Kalıntı" Style="{StaticResource ShadcnSegmentedTab}"
                                                     GroupName="SecSub" Tag="0" IsChecked="True" Checked="SecuritySubTab_Checked" />
                                        <RadioButton x:Name="SecTabDrivers" Content="BYOVD Sürücüler" Style="{StaticResource ShadcnSegmentedTab}"
                                                     GroupName="SecSub" Tag="1" Checked="SecuritySubTab_Checked" />
                                        <RadioButton x:Name="SecTabModules" Content="Enjekte DLL &amp; Eklenti" Style="{StaticResource ShadcnSegmentedTab}"
                                                     GroupName="SecSub" Tag="2" Checked="SecuritySubTab_Checked" />
                                        <RadioButton x:Name="SecTabHistory" Content="Güvenlik Geçmişi" Style="{StaticResource ShadcnSegmentedTab}"
                                                     GroupName="SecSub" Tag="3" Checked="SecuritySubTab_Checked" />
                                        <RadioButton x:Name="SecTabQuarantine" Content="Karantina Kasası" Style="{StaticResource ShadcnSegmentedTab}"
                                                     GroupName="SecSub" Tag="4" Checked="SecuritySubTab_Checked" />
                                    </WrapPanel>
                                </Border>

                                <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                                    <Button x:Name="BtnWhitelistBulk" Content="Güvenilir (Yoksay)" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" ToolTip="İşaretli veya seçili yanlış pozitifleri güvenilir listeye ekle" Command="{Binding WhitelistFindingCommand}" />
                                    <Button x:Name="BtnRemoveFindingsBulk" Content="{Binding RemoveSelectedButtonText}" Style="{StaticResource ShadcnDangerBtn}" Margin="0,0,6,0" Command="{Binding RemoveFindingCommand}" />
                                    <Button x:Name="BtnScanDrivers" Content="Sürücüleri Tara (.sys)" Style="{StaticResource ShadcnPrimaryBtn}" Visibility="Collapsed" Command="{Binding ScanKernelDriversCommand}" />
                                    <Button x:Name="BtnScanModules" Content="DLL &amp; Eklenti Tara" Style="{StaticResource ShadcnPrimaryBtn}" Visibility="Collapsed" Command="{Binding ScanInjectedAndExtensionsCommand}" />
                                    <Button x:Name="BtnClearHistoryBulk" Content="Geçmişi Temizle" Style="{StaticResource ShadcnSecondaryBtn}" Visibility="Collapsed" Command="{Binding ClearSecurityHistoryCommand}" />
                                </WrapPanel>
                            </StackPanel>

                            <!-- Sub-Panel 0: Persistence Findings with CheckBox Multi-Select -->
                            <DataGrid x:Name="PanelFindings" Grid.Row="1" ItemsSource="{Binding PersistenceFindings}" SelectedItem="{Binding SelectedFinding}"
                                      AutoGenerateColumns="False" IsReadOnly="False" CanUserAddRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="112">
                                        <DataGridTemplateColumn.Header>
                                            <CheckBox Content="Tümünü Seç" Style="{StaticResource ShadcnCheckBox}"
                                                      Click="SelectAllFindings_Click" />
                                        </DataGridTemplateColumn.Header>
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                          Style="{StaticResource ShadcnCheckBox}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Risk" Width="98">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToBgBrush}}"
                                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorderBrush}}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" Margin="2">
                                                    <TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Kategori" Width="155">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Category}" Foreground="#D4D4D8" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Category}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Öğe Adı" Width="185">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Name}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Neden / Tespit" Width="280">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Reason}" Foreground="#A1A1AA" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>

                                    <DataGridTemplateColumn Header="Hedef Yol / Komut" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TargetPath}" Foreground="#71717A" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Sub-Panel 1: Kernel Drivers (BYOVD Shield) -->
                            <Grid x:Name="PanelDrivers" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock Text="{Binding DriverScanSummary}" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,8" />
                                <DataGrid Grid.Row="1" ItemsSource="{Binding KernelDrivers}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Risk" Width="92">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Border Background="{Binding Severity, Converter={StaticResource SeverityToBgBrush}}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorderBrush}}" BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                                                        <TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontSize="11" FontWeight="SemiBold" />
                                                    </Border>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="Sürücü" Binding="{Binding Name}" Width="140" />
                                        <DataGridTemplateColumn Header="Açıklama" Width="210">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding DisplayName}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DisplayName}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="İmza" Width="88">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding IsSigned, Converter={StaticResource SignedToText}}" Foreground="{Binding IsSigned, Converter={StaticResource SignedToBrush}}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="BYOVD / Tespit" Width="260">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Reason}" Foreground="#FCA5A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Dosya Yolu" Width="*" MinWidth="180">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding ImagePath}" Foreground="#71717A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ImagePath}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Konum" Width="84">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Aç" Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,3"
                                                            Command="{Binding DataContext.OpenPathInExplorerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding ImagePath}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- Sub-Panel 2: Live Injected DLLs + Browser Extensions & Shortcut Audit -->
                            <Grid x:Name="PanelModulesAndExt" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="1*" />
                                    <RowDefinition Height="1*" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.Row="0" Text="{Binding ModuleScanSummary}" Foreground="#A1A1AA" FontSize="12" Margin="0,0,0,8" />

                                <DockPanel Grid.Row="1" Margin="0,0,0,8">
                                    <TextBlock DockPanel.Dock="Top" Text="Çalışan Süreçlerde İmzasız DLL Modülleri (Şüpheli Enjeksiyon)" Foreground="#FAFAFA" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <DataGrid ItemsSource="{Binding InjectedDlls}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PID" Binding="{Binding Pid}" Width="65" />
                                            <DataGridTextColumn Header="Hedef Süreç" Binding="{Binding ProcessName}" Width="145" />
                                            <DataGridTextColumn Header="Modül (DLL)" Binding="{Binding ModuleName}" Width="170" />
                                            <DataGridTemplateColumn Header="Dosya Yolu" Width="*" MinWidth="180">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding FilePath}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FilePath}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Neden" Width="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Reason}" Foreground="#FBBF24" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="İşlem" Width="155">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Button Content="Konum" Style="{StaticResource ShadcnSecondaryBtn}" Padding="7,3" Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.OpenPathInExplorerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding FilePath}" />
                                                            <Button Content="Kapat" Style="{StaticResource ShadcnDangerBtn}" Padding="7,3"
                                                                    Command="{Binding DataContext.KillDllProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>

                                <DockPanel Grid.Row="2">
                                    <TextBlock DockPanel.Dock="Top" Text="Tarayıcı Eklentileri &amp; Kaçırılmış Kısayol (.lnk) Denetimi" Foreground="#FAFAFA" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,4" />
                                    <DataGrid ItemsSource="{Binding BrowserExtIssues}" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                              Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn Header="Risk" Width="90">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{Binding Severity, Converter={StaticResource SeverityToBgBrush}}" BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorderBrush}}" BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                                                            <TextBlock Text="{Binding Severity}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontSize="11" FontWeight="SemiBold" />
                                                        </Border>
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTextColumn Header="Tarayıcı" Binding="{Binding Browser}" Width="115" />
                                            <DataGridTextColumn Header="Profil" Binding="{Binding Profile}" Width="105" />
                                            <DataGridTextColumn Header="Ad / Eklenti" Binding="{Binding Name}" Width="190" />
                                            <DataGridTemplateColumn Header="Neden / Yetkiler" Width="*" MinWidth="220">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding RiskReason}" Foreground="#FCA5A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding RiskReason}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                            <DataGridTemplateColumn Header="Konum" Width="84">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <Button Content="Aç" Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,3"
                                                                Command="{Binding DataContext.OpenPathInExplorerCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                                CommandParameter="{Binding FolderPath}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                            </DataGridTemplateColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </DockPanel>
                            </Grid>

                            <!-- Sub-Panel 3: Persistent Security History -->
                            <DataGrid x:Name="PanelHistory" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding SecurityHistory}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      MouseDoubleClick="PanelHistory_MouseDoubleClick"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Tarih / Saat" Width="150">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DateTimeText}" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="İşlem Türü" Width="165">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding ActionType}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding ActionType}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Hedef" Width="230">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TargetName}" Foreground="#E4E4E7" FontWeight="SemiBold" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding TargetName}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Sonuç" Width="160">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToBgBrush}}"
                                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorderBrush}}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8,2" HorizontalAlignment="Left" Margin="2">
                                                    <TextBlock Text="{Binding Verdict}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}"
                                                               FontSize="11" FontWeight="SemiBold" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Detaylar (Çift tıkla: İncele)" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Details}" Foreground="#A1A1AA" VerticalAlignment="Center"
                                                           TextTrimming="CharacterEllipsis" ToolTip="{Binding Details}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Sub-Panel 2: Encrypted Quarantine Vault -->
                            <DataGrid x:Name="PanelQuarantine" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding QuarantineItems}" SelectedItem="{Binding SelectedQuarantineItem}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="125" />
                                    <DataGridTemplateColumn Header="Dosya Adı" Width="170">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OriginalName}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Neden" Width="210">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Reason}" Foreground="#FCA5A5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Orijinal Konum" Width="*" MinWidth="180">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding OriginalPath}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding OriginalPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="İşlem" Width="175">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <Button Content="♻️ Geri Yükle" Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,3" Margin="0,0,4,0"
                                                            Command="{Binding DataContext.RestoreQuarantineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="🔥 Sil" Style="{StaticResource ShadcnDangerBtn}" Padding="8,3"
                                                            Command="{Binding DataContext.DeleteQuarantineItemCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Selected Finding Detail Inspector -->
                            <Border x:Name="FindingInspectorCard" Grid.Row="2" Background="#18181B" CornerRadius="8" Padding="12" Margin="0,10,0,0" BorderBrush="#27272A" BorderThickness="1"
                                    Visibility="{Binding SelectedFinding, Converter={StaticResource NotNullToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,14,0">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="🔍 Bulgu Detayı: " Foreground="#71717A" FontSize="12" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding SelectedFinding.Name}" Foreground="#FAFAFA" FontSize="12.5" FontWeight="Bold" />
                                            <TextBlock Text="{Binding SelectedFinding.Category, StringFormat=  ({0})}" Foreground="#A1A1AA" FontSize="12" />
                                        </StackPanel>
                                        <TextBlock Text="{Binding SelectedFinding.Reason}" Foreground="#E4E4E7" FontSize="12" Margin="0,3,0,2" TextWrapping="Wrap" />
                                        <TextBlock Foreground="#71717A" FontSize="11" TextWrapping="Wrap">
                                            <Run Text="Konum: " /><Run Text="{Binding SelectedFinding.Location}" Foreground="#A1A1AA" />
                                            <Run Text="  |  Hedef: " /><Run Text="{Binding SelectedFinding.TargetPath}" Foreground="#D4D4D8" />
                                        </TextBlock>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Content="Konumu Aç" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" Command="{Binding OpenFindingLocationCommand}" />
                                        <Button Content="Dosyayı Tara" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" Command="{Binding ScanSelectedFindingFileCommand}" />
                                        <Button Content="Güvenilir (Yoksay)" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" Command="{Binding WhitelistFindingCommand}" />
                                        <Button Content="Karantina" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" Command="{Binding QuarantineSelectedFindingCommand}" />
                                        <Button Content="Kaldır" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" Command="{Binding RemoveFindingCommand}" />
                                        <Button Style="{StaticResource ShadcnDangerBtn}" ToolTip="Süreci sonlandır + Firewall engelle + Karantinaya al + Kalıcılığı sil" Command="{Binding NeutralizeFindingCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoZap}" Stroke="#FCA5A5" Width="12" Height="12" Margin="0,0,5,0" />
                                                <TextBlock Text="Etkisiz Hale Getir" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 5: SETTINGS (2-Column shadcn Grid) -->
                <ScrollViewer x:Name="TabSettings" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,2,0">
                        <Border Background="#111113" CornerRadius="8" Padding="18" Margin="0,0,0,12" BorderBrush="#27272A" BorderThickness="1">
                            <DockPanel>
                                <StackPanel>
                                    <TextBlock Text="KOCHAN Sentinel Yapılandırması" FontSize="18" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Text="Değişiklikler anında otomatik kaydedilir ve canlı olarak sisteme uygulanır."
                                               Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,0" />
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,8,0" Command="{Binding OpenAppDataFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoFolder}" Stroke="#FAFAFA" Width="12.5" Height="12.5" Margin="0,0,6,0" />
                                            <TextBlock Text="Veri &amp; Karantina Klasörü" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                    <Button Content="Ayarları Kaydet ve Uygula" Style="{StaticResource ShadcnPrimaryBtn}" Command="{Binding SaveSettingsCommand}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- LEFT COLUMN: Genel + Mini HUD + Oyun Motoru + ISLC (zero uniform row stretch!) -->
                            <StackPanel Grid.Column="0" Margin="0,0,6,0" VerticalAlignment="Top">
                                <!-- Card 1: Genel & Görünüm -->
                                <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoSliders}" Stroke="#A1A1AA" Margin="0,0,8,0" />
                                            <TextBlock Text="Genel &amp; Otomatik Zamanlayıcı" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Content="Windows ile birlikte arka planda başlat" IsChecked="{Binding Settings.StartWithWindows}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Pencere kapatıldığında sistem tepsisine küçült" IsChecked="{Binding Settings.MinimizeToTrayOnClose}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Açılışta Mini HUD'ı göster" IsChecked="{Binding Settings.ShowMiniHudOnStart}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Açılışta yeni GitHub sürümlerini sessizce denetle" IsChecked="{Binding Settings.AutoCheckUpdatesOnStart}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Her gün 21:00 veya 15 dk boşta sessiz tarama &amp; temizlik" IsChecked="{Binding Settings.EnableAutoMaintenanceSchedule}" Margin="0,0,0,10" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Windows 11 Pencere Efekti (Backdrop):" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding BackdropPresets}" SelectedItem="{Binding Settings.WindowBackdropMode, Mode=TwoWay}" SelectionChanged="SettingCombo_SelectionChanged" />
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Card 2 (Moved near TOP!): Mini HUD Özelleştirme & Saydamlık -->
                                <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoPin}" Stroke="#38BDF8" Margin="0,0,8,0" />
                                            <TextBlock Text="Mini HUD Özelleştirme &amp; Oyun İçi Mod" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                        <UniformGrid Columns="3" Margin="0,0,0,8">
                                            <CheckBox Content="CPU %" Style="{StaticResource ShadcnCheckBox}" IsChecked="{Binding Settings.HudShowCpu}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" Margin="0,3" />
                                            <CheckBox Content="RAM %" Style="{StaticResource ShadcnCheckBox}" IsChecked="{Binding Settings.HudShowRam}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" Margin="0,3" />
                                            <CheckBox Content="GPU / Sıcaklık" Style="{StaticResource ShadcnCheckBox}" IsChecked="{Binding Settings.HudShowGpu}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" Margin="0,3" />
                                            <CheckBox Content="FPS (Present)" Style="{StaticResource ShadcnCheckBox}" IsChecked="{Binding Settings.HudShowFps}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" Margin="0,3" />
                                            <CheckBox Content="Ağ Mbps" Style="{StaticResource ShadcnCheckBox}" IsChecked="{Binding Settings.HudShowNet}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" Margin="0,3" />
                                            <CheckBox Content="Ping &amp; Jitter" Style="{StaticResource ShadcnCheckBox}" IsChecked="{Binding Settings.HudShowPing}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" Margin="0,3" />
                                        </UniformGrid>
                                        <ui:ToggleSwitch Content="Click-Through (Oyun içi tıklama geçirgenliği — fare takılmaz)" IsChecked="{Binding Settings.HudClickThrough}" Margin="0,2,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Kompakt HUD Modu (Mini şerit, sparkline gizli)" IsChecked="{Binding Settings.HudCompactMode}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="140" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Global HUD Kısayolu (NVIDIA Alt+Z çakışmasız):" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center" />
                                            <ComboBox Grid.Column="1" ItemsSource="{Binding HotkeyPresets}" SelectedItem="{Binding Settings.HudHotkeyPreset, Mode=TwoWay}" SelectionChanged="SettingCombo_SelectionChanged" />
                                        </Grid>
                                        <DockPanel Margin="0,2,0,2">
                                            <TextBlock Text="HUD Arka Plan Saydamlığı:" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" />
                                            <TextBlock Text="{Binding Settings.HudOpacity, StringFormat={}{0:P0}}" Foreground="#38BDF8" FontSize="12" FontWeight="Bold" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <Slider Minimum="0.35" Maximum="1.0" TickFrequency="0.05" IsSnapToTickEnabled="False"
                                                Value="{Binding Settings.HudOpacity, Mode=TwoWay}"
                                                ValueChanged="HudOpacitySlider_Changed" LostMouseCapture="SettingControl_AutoSave" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 3: Performans & Oyun Motoru -->
                                <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoGamepad}" Stroke="#38BDF8" Margin="0,0,8,0" />
                                            <TextBlock Text="Oyun &amp; Bellek Performans Motoru" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Content="Otomatik Oyun Modu (Oyun açılınca güç &amp; öncelik artışı)" IsChecked="{Binding Settings.AutoGameMode}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="0.5 ms Timer Resolution (Oyunlarda düşük input lag)" IsChecked="{Binding Settings.EnableTimerResolution05Ms}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="ProBalance (Oyundayken arka plan CPU sömürücülerini kıs)" IsChecked="{Binding Settings.EnableProBalance}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="RAM %85 üzerine çıktığında otomatik RAM temizle" IsChecked="{Binding Settings.AutoRamOptimizeOnHighUsage}" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                    </StackPanel>
                                </Border>

                                <!-- Card 4: ISLC Standby List Ayarları -->
                                <Border Background="#111113" CornerRadius="8" Padding="16" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoCpu}" Stroke="#C084FC" Margin="0,0,8,0" />
                                            <TextBlock Text="ISLC Otomatik Standby List Koruyucusu" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Content="Boş RAM azaldığında Standby List'i otomatik temizle" IsChecked="{Binding Settings.EnableAutoIslc}" Margin="0,0,0,10" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Boş RAM bu değerin altına düşerse (MB):" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding Settings.IslcFreeRamThresholdMb, UpdateSourceTrigger=PropertyChanged}" LostFocus="SettingControl_AutoSave" />
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="110" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Text="Ve Standby List bu değeri aşarsa (MB):" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" />
                                            <ui:TextBox Grid.Column="1" Text="{Binding Settings.IslcStandbyThresholdMb, UpdateSourceTrigger=PropertyChanged}" LostFocus="SettingControl_AutoSave" />
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!-- RIGHT COLUMN: Güvenlik Kalkanları + Yedekleme & GitHub -->
                            <StackPanel Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Top">
                                <!-- Card 5: Güvenlik Kalkanları & Whitelist -->
                                <Border Background="#111113" CornerRadius="8" Padding="16" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoShield}" Stroke="#4ADE80" Margin="0,0,8,0" />
                                            <TextBlock Text="İleri Düzey Güvenlik &amp; Güvenilir Liste" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                        <ui:ToggleSwitch Content="Gerçek zamanlı İndirilenler, Masaüstü, AppData &amp; Startup Kalkanı" IsChecked="{Binding Settings.RealTimeDownloadsShield}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Kritik tehditleri otomatik Karantinaya al (EDR Auto-Quarantine)" IsChecked="{Binding Settings.EnableAutoQuarantine}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Zararlı gizli dropper/betik süreçlerini doğarken sonlandır (Auto-Kill)" IsChecked="{Binding Settings.AutoKillMaliciousScripts}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Canlı RAT, Process Hollowing &amp; C2 ağ davranışını sürekli izle" IsChecked="{Binding Settings.EnableActiveRatMonitor}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Gizli PowerShell / Betik Süreç Dedektörü (Fast + 4104)" IsChecked="{Binding Settings.EnableHiddenProcessDetector}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Fidye Yazılımı Honeypot Kalkanı (Belgeler &amp; Masaüstü tuzağı)" IsChecked="{Binding Settings.EnableRansomwareHoneypot}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Fidye Honeypot'ta otomatik sonlandır (Kapalıysa güvenle dondurur)" IsChecked="{Binding Settings.RansomwareAutoKillMode}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Kripto Pano Koruması (Clipper cüzdan değişimi engelleyici)" IsChecked="{Binding Settings.EnableClipboardClipperGuard}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="USB / Harici Bellek Takıldığında Otomatik Zararlı Taraması" IsChecked="{Binding Settings.EnableUsbShield}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Self-Defense Bekçi Süreci (KOCHAN dışarıdan kapatılırsa geri açar)" IsChecked="{Binding Settings.EnableSelfDefenseWatchdog}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Temizlik &amp; Müdahale Öncesi Otomatik Geri Yükleme Noktası" IsChecked="{Binding Settings.EnableAutoRestorePoint}" Margin="0,0,0,7" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <ui:ToggleSwitch Content="Sürücüsüz Güvenli Sensör Modu (WinRing0 / Defender uyarısı almamak için)" IsChecked="{Binding Settings.UseSafeDriverlessSensors}" Margin="0,0,0,8" Checked="SettingControl_AutoSave" Unchecked="SettingControl_AutoSave" />
                                        <TextBlock Text="VirusTotal API Anahtarı (DPAPI Şifreli Saklanır):" Foreground="#A1A1AA" FontSize="11.5" Margin="0,2,0,3" />
                                        <ui:TextBox PlaceholderText="VirusTotal v3 x-apikey" Text="{Binding Settings.VirusTotalApiKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" LostFocus="SettingControl_AutoSave" />
                                        <TextBlock Text="MalwareBazaar Auth-Key (Opsiyonel ücretsiz abuse.ch anahtarı):" Foreground="#A1A1AA" FontSize="11.5" Margin="0,2,0,3" />
                                        <ui:TextBox PlaceholderText="abuse.ch Auth-Key (DPAPI Şifreli)" Text="{Binding Settings.MalwareBazaarAuthKey, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,6" LostFocus="SettingControl_AutoSave" />
                                        <TextBlock Text="Discord Webhook Alarm URL (Kritik tehditlerde telefona bildirim):" Foreground="#A1A1AA" FontSize="11.5" Margin="0,2,0,3" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" PlaceholderText="https://discord.com/api/webhooks/..." Text="{Binding Settings.DiscordWebhookUrl, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,6,0" LostFocus="SettingControl_AutoSave" />
                                            <Button Grid.Column="1" Content="Test Et" Style="{StaticResource ShadcnSecondaryBtn}" Command="{Binding TestDiscordWebhookCommand}" />
                                        </Grid>
                                        <TextBlock Text="Güvenilir Liste (Yoksayılan Öğeler):" Foreground="#A1A1AA" FontSize="11.5" Margin="0,2,0,4" />
                                        <ListBox ItemsSource="{Binding TrustedWhitelist}" MaxHeight="68" Background="#18181B" BorderBrush="#27272A" BorderThickness="1">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel Margin="2">
                                                        <TextBlock Text="{Binding}" Foreground="#D4D4D8" FontSize="11" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" MaxWidth="310" ToolTip="{Binding}" />
                                                        <Button Content="Çıkar" Style="{StaticResource ShadcnDangerBtn}" Padding="6,2" FontSize="10.5" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                                                Command="{Binding DataContext.RemoveWhitelistEntryCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                                CommandParameter="{Binding}" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>
                                </Border>

                                <!-- Card 6: Yedekleme, HTML Rapor & Tek Tıkla Otomatik Güncelleme -->
                                <Border Background="#111113" CornerRadius="8" Padding="16" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Path Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoRefresh}" Stroke="#4ADE80" Margin="0,0,8,0" />
                                            <TextBlock Text="Yedekleme, Rapor &amp; Otomatik Güncelleyici" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        </StackPanel>
                                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10">
                                            <Button Content="Ayarları Dışa Aktar" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,4" Click="ExportSettings_Click" />
                                            <Button Content="Ayarları İçe Aktar" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,4" Click="ImportSettings_Click" />
                                            <Button Content="HTML Sağlık Raporu" Style="{StaticResource ShadcnEmeraldBtn}" Margin="0,0,0,4" Click="ExportHtmlReport_Click" />
                                        </WrapPanel>
                                        <TextBlock Text="GitHub Releases Deposu (owner/repo):" Foreground="#A1A1AA" FontSize="11.5" Margin="0,0,0,4" />
                                        <Grid Margin="0,0,0,8">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ui:TextBox Grid.Column="0" Text="{Binding GitHubRepoSlug, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,8,0" />
                                            <Button Grid.Column="1" Content="Güncelleme Denetle" Style="{StaticResource ShadcnPrimaryBtn}" Command="{Binding CheckUpdateCommand}" />
                                        </Grid>
                                        <ProgressBar Value="{Binding UpdateProgressPercent, Mode=OneWay}" Maximum="100" Height="5" Margin="0,0,0,6" Foreground="#4ADE80"
                                                     Visibility="{Binding IsDownloadingUpdate, Converter={StaticResource BoolToVis}}" />
                                        <DockPanel>
                                            <TextBlock Text="{Binding UpdateStatusText}" Foreground="#D4D4D8" FontSize="11.5" VerticalAlignment="Center" TextWrapping="Wrap" />
                                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                                                <Button Content="Otomatik Güncelle" Style="{StaticResource ShadcnEmeraldBtn}" Padding="10,4" Margin="6,0,0,0"
                                                        Visibility="{Binding HasAvailableUpdate, Converter={StaticResource BoolToVis}}"
                                                        Command="{Binding InstallAvailableUpdateCommand}" />
                                                <Button Content="GitHub'da Aç" Padding="10,4" Margin="6,0,0,0" Command="{Binding OpenUpdateUrlCommand}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ShadcnSecondaryBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding UpdateUrl}" Value="">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>
                                            </StackPanel>
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 6: SYSTEM HARDWARE BENCHMARK (Modern shadcn / Lucide Vector Edition) -->
                <ScrollViewer x:Name="TabBenchmark" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,0,2,0">
                        <!-- Top Benchmark Hero & Controls -->
                        <Border Background="#111113" CornerRadius="10" Padding="20" Margin="0,0,0,12" BorderBrush="#27272A" BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Margin="0,0,18,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                        <Border Width="28" Height="28" CornerRadius="7" Background="#0C1E2E" BorderBrush="#1E3A8A" BorderThickness="1" Margin="0,0,10,0">
                                            <Path Data="M3,13 H6.5 V21 H3 Z M10.2,6 H13.7 V21 H10.2 Z M17.5,2 H21 V21 H17.5 Z" Width="13" Height="13" Stretch="Uniform" Fill="#38BDF8" />
                                        </Border>
                                        <TextBlock Text="KOCHAN Sistem Benchmark" FontSize="18.5" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                        <Border Background="#18181B" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" BorderBrush="#27272A" BorderThickness="1" VerticalAlignment="Center">
                                            <TextBlock Text="Gerçek Donanım Kalibrasyonu" FontSize="10.5" Foreground="#A1A1AA" FontWeight="SemiBold" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Foreground="#A1A1AA" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis">
                                        <Run Text="CPU: " /><Run Text="{Binding Metrics.CpuName}" Foreground="#E4E4E7" />
                                        <Run Text="  |  RAM: " /><Run Text="{Binding Metrics.RamTotalGb, StringFormat={}{0:F1} GB}" Foreground="#E4E4E7" />
                                        <Run Text="  |  GPU: " /><Run Text="{Binding Metrics.GpuName}" Foreground="#E4E4E7" />
                                    </TextBlock>
                                    <TextBlock Text="{Binding BenchmarkStageText}" Foreground="#FAFAFA" FontSize="12.5" FontWeight="SemiBold" Margin="0,10,0,2" />
                                    <TextBlock Text="{Binding BenchmarkDetailText}" Foreground="#71717A" FontSize="11.5" TextWrapping="Wrap" />
                                    <ProgressBar Value="{Binding BenchmarkProgressPercent, Mode=OneWay}" Maximum="100" Height="6" Margin="0,8,0,0"
                                                 Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10" HorizontalAlignment="Right">
                                        <TextBlock Text="Test Diski:" Foreground="#A1A1AA" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                                        <ComboBox Width="92" ItemsSource="{Binding AvailableBenchmarkDrives}" SelectedItem="{Binding SelectedBenchmarkDrive}" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Durdur" Style="{StaticResource ShadcnDangerBtn}" Margin="0,0,8,0"
                                                Visibility="{Binding IsBenchmarkRunning, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding CancelBenchmarkCommand}" />
                                        <Button Style="{StaticResource ShadcnPrimaryBtn}" Height="38" Padding="18,0"
                                                Command="{Binding RunFullBenchmarkCommand}">
                                            <StackPanel Orientation="Horizontal">
                                                <Path Data="M13,2 L4,14 H11 L10,22 L19,10 H12 Z" Width="13" Height="13" Stretch="Uniform" Fill="#09090B" Margin="0,0,8,0" />
                                                <TextBlock Text="Tam Testi Başlat" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Empty State CTA before first run -->
                        <Border Background="#111113" CornerRadius="10" Padding="24" Margin="0,0,0,12" BorderBrush="#27272A" BorderThickness="1">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding LatestBenchmark}" Value="{x:Null}">
                                            <Setter Property="Visibility" Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Henüz kayıtlı donanım testi yok — sağ üstten test diskini seçip Tam Testi Başlat'a tıkla."
                                           Foreground="#A1A1AA" FontSize="13" HorizontalAlignment="Center" />
                            </StackPanel>
                        </Border>

                        <!-- UserBenchmark-Style 3 Profile Triad -->
                        <Border Background="#111113" CornerRadius="10" Padding="18" Margin="0,0,0,12" BorderBrush="#27272A" BorderThickness="1"
                                Visibility="{Binding LatestBenchmark, Converter={StaticResource NotNullToVis}}">
                            <StackPanel>
                                <Grid Margin="0,0,0,14">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                        <TextBlock Text="Sistem Sınıfı &amp; Profil Puanları (Ref: %100 Modern Masaüstü)" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                        <TextBlock Text="{Binding LatestBenchmark.BottleneckNote}" Foreground="#A1A1AA" FontSize="12" Margin="0,3,0,0" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding LatestBenchmark.ThermalSummary}" Foreground="#86EFAC" FontSize="11.5" FontWeight="SemiBold" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#052E16" BorderBrush="#166534" BorderThickness="1" CornerRadius="6"
                                            Padding="12,5" VerticalAlignment="Center" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding LatestBenchmark.TierBadge}" Foreground="#86EFAC" FontWeight="Bold" FontSize="12" />
                                    </Border>
                                </Grid>

                                <UniformGrid Columns="3">
                                    <!-- Gaming Card -->
                                    <Border Background="#18181B" CornerRadius="8" Margin="0,0,6,0" BorderBrush="#27272A" BorderThickness="1" ClipToBounds="True">
                                        <StackPanel>
                                            <Border Height="2.5" Background="#38BDF8" />
                                            <StackPanel Margin="16,14">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24" CornerRadius="6" Background="#0C1E2E" Margin="0,0,8,0">
                                                        <Path Data="M6,9 H18 A4,4 0 0 1 22,13 V16 A3,3 0 0 1 17,18 L15,16 H9 L7,18 A3,3 0 0 1 2,16 V13 A4,4 0 0 1 6,9 Z" Width="12" Height="12" Stretch="Uniform" Fill="#38BDF8" />
                                                    </Border>
                                                    <TextBlock Text="OYUN (GAMING)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LatestBenchmark.GamingPercent, StringFormat={}%{0}}" FontSize="29" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,8,0,6" />
                                                <ProgressBar Value="{Binding LatestBenchmark.GamingPercent, Mode=OneWay}" Maximum="400" Height="4" Foreground="#38BDF8" Margin="0,0,0,6" />
                                                <TextBlock Text="Tek çekirdek hızı + RAM tepki süresi" FontSize="11" Foreground="#71717A" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Desktop Card -->
                                    <Border Background="#18181B" CornerRadius="8" Margin="3,0,3,0" BorderBrush="#27272A" BorderThickness="1" ClipToBounds="True">
                                        <StackPanel>
                                            <Border Height="2.5" Background="#4ADE80" />
                                            <StackPanel Margin="16,14">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24" CornerRadius="6" Background="#052E16" Margin="0,0,8,0">
                                                        <Path Data="M3,4 H21 V16 H3 Z M8,20 H16 M12,16 V20" Width="12" Height="12" Stretch="Uniform" Stroke="#4ADE80" StrokeThickness="2" />
                                                    </Border>
                                                    <TextBlock Text="MASAÜSTÜ (DESKTOP)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LatestBenchmark.DesktopPercent, StringFormat={}%{0}}" FontSize="29" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,8,0,6" />
                                                <ProgressBar Value="{Binding LatestBenchmark.DesktopPercent, Mode=OneWay}" Maximum="400" Height="4" Foreground="#4ADE80" Margin="0,0,0,6" />
                                                <TextBlock Text="Tek çekirdek + NVMe/SSD 4K açılış tepkisi" FontSize="11" Foreground="#71717A" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Workstation Card -->
                                    <Border Background="#18181B" CornerRadius="8" Margin="6,0,0,0" BorderBrush="#27272A" BorderThickness="1" ClipToBounds="True">
                                        <StackPanel>
                                            <Border Height="2.5" Background="#C084FC" />
                                            <StackPanel Margin="16,14">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="24" Height="24" CornerRadius="6" Background="#1E1033" Margin="0,0,8,0">
                                                        <Path Data="M4,4 H20 V20 H4 Z M8,8 H16 V16 H8 Z" Width="12" Height="12" Stretch="Uniform" Fill="#C084FC" />
                                                    </Border>
                                                    <TextBlock Text="İŞ İSTASYONU (WORKSTATION)" FontSize="11" FontWeight="SemiBold" Foreground="#A1A1AA" VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="{Binding LatestBenchmark.WorkstationPercent, StringFormat={}%{0}}" FontSize="29" FontWeight="Bold" Foreground="#FAFAFA" Margin="0,8,0,6" />
                                                <ProgressBar Value="{Binding LatestBenchmark.WorkstationPercent, Mode=OneWay}" Maximum="400" Height="4" Foreground="#C084FC" Margin="0,0,0,6" />
                                                <TextBlock Text="Çoklu çekirdek gücü + RAM bant genişliği" FontSize="11" Foreground="#71717A" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!-- Detailed Component Metrics -->
                        <UniformGrid Columns="5" Margin="0,0,0,12"
                                     Visibility="{Binding LatestBenchmark, Converter={StaticResource NotNullToVis}}">
                            <Border Background="#111113" CornerRadius="8" Padding="14" Margin="0,0,5,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CPU TEK ÇEKİRDEK" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <TextBlock Text="{Binding LatestBenchmark.CpuSingleScore, StringFormat={}{0} Puan}" FontSize="20" FontWeight="Bold" Foreground="#FBBF24" Margin="0,6,0,6" />
                                    <ProgressBar Value="{Binding LatestBenchmark.CpuSingleScore, Mode=OneWay}" Maximum="400" Height="4" Foreground="#FBBF24" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding LatestBenchmark.CpuSingleMops, StringFormat=Hız: {0:F1} Mops/s}" FontSize="11" Foreground="#D4D4D8" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="14" Margin="3,0,3,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="CPU ÇOK ÇEKİRDEK" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <TextBlock Text="{Binding LatestBenchmark.CpuMultiScore, StringFormat={}{0} Puan}" FontSize="20" FontWeight="Bold" Foreground="#F59E0B" Margin="0,6,0,6" />
                                    <ProgressBar Value="{Binding LatestBenchmark.CpuMultiScore, Mode=OneWay}" Maximum="500" Height="4" Foreground="#F59E0B" Margin="0,0,0,6" />
                                    <TextBlock FontSize="11" Foreground="#D4D4D8">
                                        <Run Text="{Binding LatestBenchmark.CpuMultiMops, StringFormat={}{0:F1} Mops/s}" />
                                        <Run Text="{Binding LatestBenchmark.CpuScalingRatio, StringFormat= ({0:F1}x)}" Foreground="#A1A1AA" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="14" Margin="3,0,3,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="RAM BELLEK" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <TextBlock Text="{Binding LatestBenchmark.RamBandwidthGbPerSec, StringFormat={}{0:F1} GB/s}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" Margin="0,6,0,6" />
                                    <ProgressBar Value="{Binding LatestBenchmark.RamScore, Mode=OneWay}" Maximum="300" Height="4" Foreground="#38BDF8" Margin="0,0,0,6" />
                                    <TextBlock FontSize="11" Foreground="#D4D4D8">
                                        <Run Text="Gecikme: " /><Run Text="{Binding LatestBenchmark.RamLatencyNs, StringFormat={}{0:F1} ns}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="14" Margin="3,0,3,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="3D VEKTÖR / SIMD" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <TextBlock Text="{Binding LatestBenchmark.GpuScore, StringFormat={}{0} Puan}" FontSize="20" FontWeight="Bold" Foreground="#C084FC" Margin="0,6,0,6" />
                                    <ProgressBar Value="{Binding LatestBenchmark.GpuScore, Mode=OneWay}" Maximum="500" Height="4" Foreground="#C084FC" Margin="0,0,0,6" />
                                    <TextBlock Text="{Binding LatestBenchmark.GpuThroughputMops, StringFormat={}{0:F1} Mvec/s}" FontSize="11" Foreground="#D4D4D8" />
                                </StackPanel>
                            </Border>

                            <Border Background="#111113" CornerRadius="8" Padding="14" Margin="5,0,0,0" BorderBrush="#27272A" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="DİSK / NVMe" FontSize="10" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                    <TextBlock FontSize="20" FontWeight="Bold" Foreground="#4ADE80" Margin="0,6,0,6">
                                        <Run Text="{Binding LatestBenchmark.DiskSeqReadMbps, StringFormat={}{0:F0}}" /><Run Text=" MB/s" FontSize="12" />
                                    </TextBlock>
                                    <ProgressBar Value="{Binding LatestBenchmark.DiskScore, Mode=OneWay}" Maximum="300" Height="4" Foreground="#4ADE80" Margin="0,0,0,6" />
                                    <TextBlock FontSize="10.5" Foreground="#D4D4D8" TextTrimming="CharacterEllipsis">
                                        <Run Text="Y: " /><Run Text="{Binding LatestBenchmark.DiskSeqWriteMbps, StringFormat={}{0:F0}M}" />
                                        <Run Text=" | 4K: " /><Run Text="{Binding LatestBenchmark.DiskRandom4kReadIops, StringFormat={}{0:N0}}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </UniformGrid>

                        <!-- Benchmark Comparison History -->
                        <Border Background="#111113" CornerRadius="10" Padding="16" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,10">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Path Data="M12,8 V12 L15,14 M12,2 A10,10 0 1 0 22,12 A10,10 0 1 0 12,2 Z" Width="14" Height="14" Stretch="Uniform"
                                              Stroke="#A1A1AA" StrokeThickness="2" Margin="0,0,8,0" VerticalAlignment="Center" />
                                        <TextBlock Text="Önceki Benchmark Sonuçları (Optimizasyon Öncesi / Sonrası Karşılaştır)" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <Button Content="Geçmişi Temizle" Style="{StaticResource ShadcnSecondaryBtn}" Padding="10,4" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                            Command="{Binding ClearBenchmarkHistoryCommand}" />
                                </DockPanel>
                                <DataGrid ItemsSource="{Binding BenchmarkHistory}" MaxHeight="240"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Tarih" Binding="{Binding TimestampText}" Width="125" />
                                        <DataGridTextColumn Header="Disk" Binding="{Binding TargetDrive}" Width="50" />
                                        <DataGridTextColumn Header="Genel %" Binding="{Binding OverallScore, StringFormat={}%{0}}" Width="75" />
                                        <DataGridTextColumn Header="Oyun %" Binding="{Binding GamingPercent, StringFormat={}%{0}}" Width="75" />
                                        <DataGridTextColumn Header="CPU 1C / MC" Width="105">
                                            <DataGridTextColumn.Binding>
                                                <MultiBinding StringFormat="{}{0} / {1}">
                                                    <Binding Path="CpuSingleScore" />
                                                    <Binding Path="CpuMultiScore" />
                                                </MultiBinding>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="RAM" Binding="{Binding RamBandwidthGbPerSec, StringFormat={}{0:F1} GB/s}" Width="95" />
                                        <DataGridTextColumn Header="Disk Oku / Yaz" Width="145">
                                            <DataGridTextColumn.Binding>
                                                <MultiBinding StringFormat="{}{0:F0} / {1:F0} MB/s">
                                                    <Binding Path="DiskSeqReadMbps" />
                                                    <Binding Path="DiskSeqWriteMbps" />
                                                </MultiBinding>
                                            </DataGridTextColumn.Binding>
                                        </DataGridTextColumn>
                                        <DataGridTextColumn Header="4K IOPS (R)" Binding="{Binding DiskRandom4kReadIops, StringFormat={}{0:N0}}" Width="95" />
                                        <DataGridTemplateColumn Header="Sınıf" Width="*" MinWidth="120">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding TierBadge}" Foreground="#D4D4D8" VerticalAlignment="Center"
                                                               TextTrimming="CharacterEllipsis" ToolTip="{Binding TierBadge}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>

                <!-- TAB 7: TREESIZE DISK ANALYZER -->
                <Grid x:Name="TabDiskAnalyzer" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Top Control Card -->
                    <Border Grid.Row="0" Background="#111113" CornerRadius="10" Padding="18" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,16,0">
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <Border Width="28" Height="28" CornerRadius="7" Background="#0C1E2E" BorderBrush="#1E3A8A" BorderThickness="1" Margin="0,0,10,0">
                                        <Path Data="M2,5 A2,2 0 0 1 4,3 H9 L11,5 H20 A2,2 0 0 1 22,7 V19 A2,2 0 0 1 20,21 H4 A2,2 0 0 1 2,19 Z"
                                              Width="13" Height="13" Stretch="Uniform" Stroke="#38BDF8" StrokeThickness="2" />
                                    </Border>
                                    <TextBlock Text="TreeSize Disk &amp; Klasör Analizi" FontSize="18" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                    <Border Background="#18181B" CornerRadius="6" Padding="8,2" Margin="10,0,0,0" BorderBrush="#27272A" BorderThickness="1" VerticalAlignment="Center"
                                            Visibility="{Binding DiskSummaryStats, Converter={StaticResource NotNullToVis}}">
                                        <TextBlock Text="{Binding DiskSummaryStats}" FontSize="11" Foreground="#86EFAC" FontWeight="SemiBold" />
                                    </Border>
                                </StackPanel>
                                <TextBlock Text="{Binding DiskScanStatusText}" Foreground="#E4E4E7" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding DiskScanLivePath}" Foreground="#71717A" FontSize="11" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding DiskScanLivePath}" />
                            </StackPanel>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,8">
                                    <ComboBox Width="90" ItemsSource="{Binding AvailableBenchmarkDrives}" SelectedItem="{Binding SelectedDiskTarget}" Margin="0,0,6,0" />
                                    <Button Content="Klasör Seç" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" Click="BrowseDiskFolder_Click" />
                                    <Button Content="Üst Klasör" Style="{StaticResource ShadcnSecondaryBtn}" ToolTip="Bir üst dizini tara" Command="{Binding NavigateParentDiskFolderCommand}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="İptal" Style="{StaticResource ShadcnDangerBtn}" Margin="0,0,8,0"
                                            Visibility="{Binding IsDiskAnalyzing, Converter={StaticResource BoolToVis}}"
                                            Command="{Binding CancelDiskAnalysisCommand}" />
                                    <Button Style="{StaticResource ShadcnPrimaryBtn}" Height="36" Padding="18,0"
                                            Command="{Binding RunDiskAnalysisCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <Path Data="M11,3 A8,8 0 1 0 19,11 A8,8 0 1 0 11,3 Z M21,21 L16.65,16.65" Width="13" Height="13" Stretch="Uniform"
                                                  Stroke="#09090B" StrokeThickness="2.2" Margin="0,0,8,0" />
                                            <TextBlock Text="Diski Tara" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Main Segmented Content Card -->
                    <Border Grid.Row="1" Background="#111113" CornerRadius="10" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Background="#18181B" CornerRadius="8" Padding="3" BorderBrush="#27272A" BorderThickness="1">
                                    <StackPanel Orientation="Horizontal">
                                        <RadioButton Content="Klasör Ağacı (TreeSize)" Style="{StaticResource ShadcnSegmentedTab}" GroupName="DiskSub" Tag="0" IsChecked="True" Checked="DiskSubTab_Checked" />
                                        <RadioButton Content="En Büyük Dosyalar (Top 60)" Style="{StaticResource ShadcnSegmentedTab}" GroupName="DiskSub" Tag="1" Checked="DiskSubTab_Checked" />
                                        <RadioButton Content="Dosya Türü Dağılımı" Style="{StaticResource ShadcnSegmentedTab}" GroupName="DiskSub" Tag="2" Checked="DiskSubTab_Checked" />
                                        <RadioButton Content="Yinelenen Dosyalar (Duplicate)" Style="{StaticResource ShadcnSegmentedTab}" GroupName="DiskSub" Tag="3" Checked="DiskSubTab_Checked" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                    <Button Content="Konumu Aç" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" ToolTip="Seçili öğeyi Windows Gezgini içinde aç" Command="{Binding OpenDiskNodeLocationCommand}" />
                                    <Button Content="İçine Gir (Tara)" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,0" ToolTip="Sadece bu klasörün altını tara" Command="{Binding DrillIntoDiskNodeCommand}" />
                                    <Button Content="Geri Dönüşüme Sil" Style="{StaticResource ShadcnDangerBtn}" ToolTip="Kalıcı silmeden Geri Dönüşüm Kutusuna taşır (Windows sistem dosyaları korumalıdır)" Command="{Binding RecycleDiskNodeCommand}" />
                                </StackPanel>
                            </Grid>

                            <!-- Sub-Panel 0: TreeView Left + Interactive Treemap Right + Skeleton Overlay -->
                            <Grid x:Name="PanelDiskTree" Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="1.22*" />
                                    <ColumnDefinition Width="1*" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                    </Grid.RowDefinitions>

                                    <!-- Tree Table Column Header -->
                                    <Border Grid.Row="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1,1,1,0" CornerRadius="6,6,0,0" Padding="12,7">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="86" />
                                                <ColumnDefinition Width="95" />
                                                <ColumnDefinition Width="52" />
                                                <ColumnDefinition Width="125" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Klasör / Dosya Adı" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                            <TextBlock Grid.Column="1" Text="Boyut" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Right" Margin="0,0,10,0" />
                                            <TextBlock Grid.Column="2" Text="Kaplama" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                            <TextBlock Grid.Column="3" Text="%" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" HorizontalAlignment="Right" Margin="0,0,8,0" />
                                            <TextBlock Grid.Column="4" Text="İçerik" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                        </Grid>
                                    </Border>

                                    <TreeView Grid.Row="1" ItemsSource="{Binding DiskTreeRoots}" SelectedItemChanged="DiskTree_SelectedItemChanged"
                                              Background="#09090B" BorderBrush="#27272A" BorderThickness="1" Padding="4"
                                              ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <TreeView.ItemContainerStyle>
                                            <Style TargetType="TreeViewItem" BasedOn="{StaticResource {x:Type TreeViewItem}}">
                                                <Setter Property="IsExpanded" Value="{Binding IsExpanded, Mode=TwoWay}" />
                                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                <Setter Property="Padding" Value="2,3" />
                                            </Style>
                                        </TreeView.ItemContainerStyle>
                                        <TreeView.ItemTemplate>
                                            <HierarchicalDataTemplate ItemsSource="{Binding Children}">
                                                <Grid ToolTip="{Binding FullPath}" Margin="0,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="86" />
                                                        <ColumnDefinition Width="95" />
                                                        <ColumnDefinition Width="52" />
                                                        <ColumnDefinition Width="125" />
                                                    </Grid.ColumnDefinitions>

                                                    <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,6,0">
                                                        <Path Width="13" Height="13" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                              Data="{StaticResource GeoFolder}"
                                                              Fill="#FBBF24" Visibility="{Binding IsDirectory, Converter={StaticResource BoolToVis}}" />
                                                        <Path Width="12" Height="12" Stretch="Uniform" Margin="0,0,7,0" VerticalAlignment="Center"
                                                              Data="M6,2 H14 L20,8 V22 H6 Z M14,2 V8 H20"
                                                              Stroke="#94A3B8" StrokeThickness="1.8" Visibility="{Binding IsDirectory, Converter={StaticResource InvBoolToVis}}" />
                                                        <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontSize="12" FontWeight="Medium" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1" Text="{Binding SizeFormatted}" Foreground="#FAFAFA" FontWeight="Bold" FontSize="12"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,10,0" />

                                                    <ProgressBar Grid.Column="2" Value="{Binding PercentOfParent, Mode=OneWay}" Maximum="100" Height="6" VerticalAlignment="Center"
                                                                 Foreground="{Binding PercentOfParent, Converter={StaticResource DiskPctToBrush}}" Margin="0,0,8,0" />

                                                    <TextBlock Grid.Column="3" Text="{Binding PercentText}" Foreground="#A1A1AA" FontSize="11"
                                                               VerticalAlignment="Center" HorizontalAlignment="Right" Margin="0,0,8,0" />

                                                    <TextBlock Grid.Column="4" Text="{Binding ItemsSummary}" Foreground="#71717A" FontSize="10.5"
                                                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                </Grid>
                                            </HierarchicalDataTemplate>
                                        </TreeView.ItemTemplate>
                                    </TreeView>

                                    <!-- Animated Skeleton Loading Rows during Disk Scan -->
                                    <StackPanel Grid.Row="1" Margin="10" VerticalAlignment="Top"
                                                Visibility="{Binding IsDiskAnalyzing, Converter={StaticResource BoolToVis}}">
                                        <Border Style="{StaticResource ShadcnSkeletonBar}" Height="32" Margin="0,4" />
                                        <Border Style="{StaticResource ShadcnSkeletonBar}" Height="28" Margin="18,4,0,4" />
                                        <Border Style="{StaticResource ShadcnSkeletonBar}" Height="28" Margin="18,4,0,4" />
                                        <Border Style="{StaticResource ShadcnSkeletonBar}" Height="28" Margin="34,4,0,4" />
                                        <Border Style="{StaticResource ShadcnSkeletonBar}" Height="28" Margin="0,4" />
                                    </StackPanel>
                                </Grid>

                                <!-- Interactive Squarified Treemap Panel -->
                                <Border Grid.Column="1" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="6" Margin="10,0,0,0" Padding="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                        </Grid.RowDefinitions>
                                        <DockPanel Grid.Row="0" Margin="2,0,2,6">
                                            <TextBlock Text="Görsel Alan Haritası (Treemap)" FontSize="11.5" FontWeight="SemiBold" Foreground="#A1A1AA" />
                                            <TextBlock Text="Çift Tık: İçine Gir" FontSize="10.5" Foreground="#71717A" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                                        </DockPanel>
                                        <controls:TreemapControl x:Name="DiskTreemap" Grid.Row="1"
                                                                 RootNode="{Binding CurrentDiskRoot}"
                                                                 SelectedNode="{Binding SelectedDiskNode, Mode=TwoWay}" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!-- Sub-Panel 1: Top 60 Largest Individual Files -->
                            <DataGrid x:Name="PanelDiskTopFiles" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding TopLargestFiles}"
                                      SelectedItem="{Binding SelectedDiskNode}"
                                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                      Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="Dosya Adı" Width="220">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Boyut" Width="100">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SizeFormatted}" Foreground="#FBBF24" FontWeight="Bold" VerticalAlignment="Center" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Tür" Width="75">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="4" Padding="6,1" HorizontalAlignment="Left">
                                                    <TextBlock Text="{Binding Extension}" Foreground="#A1A1AA" FontSize="11" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Tarih" Binding="{Binding DateText}" Width="120" />
                                    <DataGridTemplateColumn Header="Tam Konum" Width="*" MinWidth="200">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding FullPath}" Foreground="#71717A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="İşlem" Width="225">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="2">
                                                    <Button Content="Konum" Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,3" Margin="0,0,6,0"
                                                            Command="{Binding DataContext.OpenDiskNodeLocationCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                    <Button Content="Geri Dönüşüme Sil" Style="{StaticResource ShadcnDangerBtn}" Padding="8,3"
                                                            ToolTip="Kalıcı silmeden Geri Dönüşüm Kutusuna taşır"
                                                            Command="{Binding DataContext.RecycleDiskNodeCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Sub-Panel 2: Extension / Category Breakdown -->
                            <ItemsControl x:Name="PanelDiskTypes" Grid.Row="1" Visibility="Collapsed" ItemsSource="{Binding DiskExtensionStats}" Margin="0,6,0,0">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#18181B" CornerRadius="8" Padding="14" Margin="0,4" BorderBrush="#27272A" BorderThickness="1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="290" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="120" />
                                                    <ColumnDefinition Width="75" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding CategoryName}" Foreground="#FAFAFA" FontSize="13" FontWeight="SemiBold" />
                                                    <TextBlock Text="{Binding FileCount, StringFormat={}{0:N0} dosya}" Foreground="#71717A" FontSize="11" />
                                                </StackPanel>
                                                <ProgressBar Grid.Column="1" Value="{Binding Percent, Mode=OneWay}" Maximum="100" Height="8" VerticalAlignment="Center"
                                                             Foreground="{Binding AccentColor, Converter={StaticResource HexToBrush}}" Margin="12,0" />
                                                <TextBlock Grid.Column="2" Text="{Binding SizeFormatted}" Foreground="#FAFAFA" FontSize="14" FontWeight="Bold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="3" Text="{Binding PercentFormatted}" Foreground="#A1A1AA" FontSize="12.5" FontWeight="SemiBold" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <!-- Sub-Panel 3: SHA-256 Duplicate File Finder -->
                            <Grid x:Name="PanelDiskDuplicates" Grid.Row="1" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="0" Background="#18181B" CornerRadius="8" Padding="12" Margin="0,0,0,8" BorderBrush="#27272A" BorderThickness="1">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding DuplicateSummaryText}" Foreground="#D4D4D8" FontSize="12" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button Content="İptal" Style="{StaticResource ShadcnDangerBtn}" Margin="0,0,6,0"
                                                    Visibility="{Binding IsFindingDuplicates, Converter={StaticResource BoolToVis}}"
                                                    Command="{Binding CancelDuplicateScanCommand}" />
                                            <Button Content="Yinelenen Dosyaları Ara (SHA-256)" Style="{StaticResource ShadcnPrimaryBtn}"
                                                    Command="{Binding FindDuplicatesCommand}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                <DataGrid Grid.Row="1" ItemsSource="{Binding DuplicateGroups}"
                                          AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                                          ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                          Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Örnek Dosya" Binding="{Binding FileNameSample}" Width="200" />
                                        <DataGridTextColumn Header="Tekil Boyut" Binding="{Binding FileSizeFormatted}" Width="95" />
                                        <DataGridTextColumn Header="Kopya" Binding="{Binding CopyCount}" Width="62" />
                                        <DataGridTemplateColumn Header="Kazanılabilir" Width="105">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding WastedFormatted}" Foreground="#FBBF24" FontWeight="Bold" VerticalAlignment="Center" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Bulunan Konumlar" Width="*" MinWidth="220">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding PathsPreview}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding PathsPreview}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn Header="Temizlik" Width="175">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <Button Content="Fazlalıkları Sil (Çöp)" Style="{StaticResource ShadcnDangerBtn}" Padding="8,3"
                                                            ToolTip="En eski orijinali korur, diğer kopyaları Geri Dönüşüm Kutusuna taşır"
                                                            Command="{Binding DataContext.RecycleDuplicateCopiesCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                            CommandParameter="{Binding}" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>

                            <!-- Bottom Selected Path Bar -->
                            <Border Grid.Row="2" Background="#18181B" CornerRadius="6" Padding="10,6" Margin="0,10,0,0" BorderBrush="#27272A" BorderThickness="1"
                                    Visibility="{Binding SelectedDiskNode, Converter={StaticResource NotNullToVis}}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{Binding SelectedDiskNode.FullPath}" Foreground="#A1A1AA" FontSize="11.5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                    <TextBlock Grid.Column="1" Text="{Binding SelectedDiskNode.SizeFormatted}" Foreground="#FAFAFA" FontWeight="Bold" FontSize="12" Margin="12,0,0,0" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- TAB 8: HARDWARE, MONITOR COLOR, DRIVERS, SERVICES & GITHUB TWEAKS STUDIO -->
                <views:HardwareStudioView x:Name="TabHardwareStudio" Visibility="Collapsed" />

                <!-- Floating Bottom-Right Toast Notification Stack -->
                <ItemsControl ItemsSource="{Binding ActiveToasts}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                              Margin="0,0,14,14" Width="340" Panel.ZIndex="99">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#F4111113" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="8"
                                    Padding="12,10" Margin="0,6,0,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="2" Background="{Binding AccentColor, Converter={StaticResource HexToBrush}}" Margin="0,0,10,0" />
                                    <StackPanel Grid.Column="1" Margin="8,0,8,0">
                                        <TextBlock Text="{Binding Title}" Foreground="#FAFAFA" FontSize="12.5" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Message}" Foreground="#A1A1AA" FontSize="11.5" TextWrapping="Wrap" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button Grid.Column="2" Content="✕" Foreground="#71717A" Background="Transparent" BorderThickness="0"
                                            Padding="6,2" VerticalAlignment="Top" Cursor="Hand"
                                            Command="{Binding DataContext.DismissToastCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Height="28" Background="#09090B" Padding="14,0" BorderBrush="#27272A" BorderThickness="0,1,0,0">
            <DockPanel VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusBanner}" Foreground="#A1A1AA" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="Ctrl+K: Komut Paleti" Foreground="#52525B" FontSize="10.5" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <ui:ProgressRing IsIndeterminate="True" Width="14" Height="14"
                                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}" />
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Global Command Palette Overlay (Ctrl + K) -->
        <views:CommandPaletteOverlay Grid.RowSpan="4" Panel.ZIndex="150" />
    </Grid>
</ui:FluentWindow>
