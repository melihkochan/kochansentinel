<UserControl x:Class="KochanSentinel.App.Views.HardwareStudioView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Top Segmented Studio Switcher (3 Clean Focused Tabs) -->
        <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="10,8" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" HorizontalAlignment="Left" Background="#18181B" CornerRadius="8" Padding="3" BorderBrush="#27272A" BorderThickness="1">
                    <WrapPanel Orientation="Horizontal">
                        <RadioButton Content="Monitör &amp; Renk Kalibrasyonu" Style="{StaticResource ShadcnSegmentedTab}" GroupName="StudioSub" Tag="0" IsChecked="True" Checked="StudioSubTab_Checked" />
                        <RadioButton Content="Eksik Sürücüler &amp; Güncelleme" Style="{StaticResource ShadcnSegmentedTab}" GroupName="StudioSub" Tag="1" Checked="StudioSubTab_Checked" />
                        <RadioButton Content="Gereksiz Servis &amp; Süreçler" Style="{StaticResource ShadcnSegmentedTab}" GroupName="StudioSub" Tag="2" Checked="StudioSubTab_Checked" />
                    </WrapPanel>
                </Border>
                <TextBlock Grid.Column="1" Text="Tüm değişiklikler geri alınabilir + Otomatik Yedek Sigortalı" Foreground="#71717A" FontSize="11"
                           VerticalAlignment="Center" Margin="10,0,0,0" />
            </Grid>
        </Border>

        <!-- SUB-PANEL 0: MONITOR & LIVE DWM COLOR CALIBRATION -->
        <ScrollViewer x:Name="PanelMonitorColor" Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,2,0">
                <Border Background="#111113" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Margin="0,0,14,0">
                            <TextBlock Text="Monitör Yenileme Hızı (Hz), Parlaklık &amp; Canlı Renk Stüdyosu" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                            <TextBlock Text="{Binding MonitorSummaryText}" Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="↺ Tüm Renkleri Sıfırla" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,8,0"
                                    Command="{Binding ResetDisplayAndColorCommand}" ToolTip="Parlaklık, kontrast ve renk profilini anında varsayılana döndürür" />
                            <Button Content="Ekranları Yeniden Tara" Style="{StaticResource ShadcnPrimaryBtn}" Command="{Binding ScanMonitorsCommand}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Detected Monitors Cards (ALL Run bindings strictly Mode=OneWay!) -->
                <ItemsControl ItemsSource="{Binding Monitors}" Margin="0,0,0,10">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="#111113" CornerRadius="8" Padding="14" Margin="0,0,0,8" BorderBrush="#27272A" BorderThickness="1">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding FriendlyName, Mode=OneWay}" Foreground="#FAFAFA" FontSize="14.5" FontWeight="SemiBold" />
                                                <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="7,2" Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding RefreshStatusBadge, Mode=OneWay}" Foreground="#38BDF8" FontSize="10.5" FontWeight="SemiBold" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,0">
                                                <Run Text="{Binding ResolutionSummary, Mode=OneWay}" />
                                                <Run Text="  •  Renk Derinliği: " /><Run Text="{Binding BitsPerPixel, Mode=OneWay, StringFormat={}{0}-bit}" Foreground="#E4E4E7" />
                                                <Run Text="  •  ICC: " /><Run Text="{Binding IccProfileName, Mode=OneWay}" Foreground="#E4E4E7" />
                                            </TextBlock>
                                        </StackPanel>
                                        <Button Grid.Column="1" Content="⚡ Maksimum Hz'e Geç" Style="{StaticResource ShadcnEmeraldBtn}" VerticalAlignment="Center"
                                                Visibility="{Binding NeedsRefreshRateBoost, Mode=OneWay, Converter={StaticResource BoolToVis}}"
                                                Command="{Binding DataContext.BoostMonitorMaxRefreshRateCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}" />
                                    </Grid>
                                    <Border Grid.Row="1" Background="#18181B" CornerRadius="6" Padding="10,8" Margin="0,10,0,0" BorderBrush="#27272A" BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="AKILLI EKRAN &amp; RENK ÖNERİLERİ" Foreground="#38BDF8" FontSize="10" FontWeight="Bold" Margin="0,0,0,4" />
                                            <TextBlock Foreground="#D4D4D8" FontSize="11.5" TextWrapping="Wrap">
                                                <Run Text="• " /><Run Text="{Binding RecommendationsText, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Split: Live DWM/DDC Brightness & Contrast + Modern Visual Color Preset Grid -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1*" />
                        <ColumnDefinition Width="1.55*" />
                    </Grid.ColumnDefinitions>

                    <!-- Left: Brightness/Contrast & Windows Tools -->
                    <StackPanel Grid.Column="0" Margin="0,0,10,0">
                        <Border Background="#111113" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock Text="Canlı Parlaklık &amp; Kontrast" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" VerticalAlignment="Center" />
                                    <Button Content="Sıfırla" Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,2" FontSize="11"
                                            DockPanel.Dock="Right" HorizontalAlignment="Right" Command="{Binding ResetDisplayAndColorCommand}" />
                                </DockPanel>

                                <!-- Engine Mode Switcher: DWM GPU (Instant on all monitors) vs Hardware DDC/CI -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="6" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="⚡ DWM GPU (Anında)" Padding="8,5" FontSize="11"
                                            Command="{Binding SetBrightnessControlModeCommand}" CommandParameter="dwm">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShadcnSecondaryBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsDwmSoftwareMode}" Value="True">
                                                        <Setter Property="Background" Value="#052E16" />
                                                        <Setter Property="BorderBrush" Value="#22C55E" />
                                                        <Setter Property="Foreground" Value="#86EFAC" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                    <Button Grid.Column="2" Content="🖥 Donanım (DDC/CI)" Padding="8,5" FontSize="11"
                                            Command="{Binding SetBrightnessControlModeCommand}" CommandParameter="ddc">
                                        <Button.Style>
                                            <Style TargetType="Button" BasedOn="{StaticResource ShadcnSecondaryBtn}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding UseHardwareDdcMode}" Value="True">
                                                        <Setter Property="Background" Value="#0C2A3E" />
                                                        <Setter Property="BorderBrush" Value="#38BDF8" />
                                                        <Setter Property="Foreground" Value="#7DD3FC" />
                                                        <Setter Property="FontWeight" Value="SemiBold" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Button.Style>
                                    </Button>
                                </Grid>

                                <Border Background="#18181B" CornerRadius="6" Padding="9,6" Margin="0,0,0,12" BorderBrush="#27272A" BorderThickness="1">
                                    <TextBlock Text="{Binding BrightnessControlModeText}" Foreground="#38BDF8" FontSize="11" TextWrapping="Wrap" />
                                </Border>

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Parlaklık (Brightness)" Foreground="#E4E4E7" FontSize="12" FontWeight="Medium" />
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="7,1" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MonitorBrightnessValue, StringFormat={}%{0}}" Foreground="#FBBF24" FontWeight="Bold" FontSize="12" />
                                    </Border>
                                </DockPanel>
                                <Slider x:Name="BrightnessSlider" Minimum="25" Maximum="100" IsMoveToPointEnabled="True"
                                        Value="{Binding MonitorBrightnessValue, Mode=TwoWay}"
                                        ValueChanged="BrightnessSlider_ValueChanged" Margin="0,0,0,12" />

                                <DockPanel Margin="0,0,0,4">
                                    <TextBlock Text="Kontrast (Contrast)" Foreground="#E4E4E7" FontSize="12" FontWeight="Medium" />
                                    <Border Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="7,1" DockPanel.Dock="Right" HorizontalAlignment="Right">
                                        <TextBlock Text="{Binding MonitorContrastValue, StringFormat={}%{0}}" Foreground="#38BDF8" FontWeight="Bold" FontSize="12" />
                                    </Border>
                                </DockPanel>
                                <Slider x:Name="ContrastSlider" Minimum="10" Maximum="100" IsMoveToPointEnabled="True"
                                        Value="{Binding MonitorContrastValue, Mode=TwoWay}"
                                        ValueChanged="ContrastSlider_ValueChanged" />
                            </StackPanel>
                        </Border>

                        <Border Background="#111113" CornerRadius="8" Padding="15" BorderBrush="#27272A" BorderThickness="1">
                            <StackPanel>
                                <TextBlock Text="Windows Kalibrasyon Araçları" FontSize="14" FontWeight="SemiBold" Foreground="#FAFAFA" Margin="0,0,0,8" />
                                <WrapPanel Orientation="Horizontal">
                                    <Button Content="Ekran Renk Kalibrasyonu (DCCW)" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,6" Command="{Binding LaunchDisplayToolCommand}" CommandParameter="dccw.exe" />
                                    <Button Content="ICC Renk Yönetimi" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,6" Command="{Binding LaunchDisplayToolCommand}" CommandParameter="colorcpl.exe" />
                                    <Button Content="ClearType Yazı Netliği" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,6" Command="{Binding LaunchDisplayToolCommand}" CommandParameter="cttune.exe" />
                                    <Button Content="Windows HDR &amp; Ekran" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,0,6" Command="{Binding LaunchDisplayToolCommand}" CommandParameter="ms-settings:display" />
                                </WrapPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Right: Modern 2-Column Visual Color & Vibrance Preset Cards -->
                    <Border Grid.Column="1" Background="#111113" CornerRadius="8" Padding="15" BorderBrush="#27272A" BorderThickness="1">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,12">
                                <StackPanel>
                                    <TextBlock Text="Canlı Renk, Vibrance &amp; Göz Koruma Profilleri" FontSize="14.5" FontWeight="SemiBold" Foreground="#FAFAFA" />
                                    <TextBlock Foreground="#A1A1AA" FontSize="11.5" Margin="0,2,0,0">
                                        <Run Text="Aktif Profil: " /><Run Text="{Binding ActiveColorPresetName, Mode=OneWay}" Foreground="#4ADE80" FontWeight="SemiBold" />
                                    </TextBlock>
                                </StackPanel>
                                <Border DockPanel.Dock="Right" HorizontalAlignment="Right" VerticalAlignment="Center"
                                        Background="#052E16" BorderBrush="#166534" BorderThickness="1" CornerRadius="6" Padding="8,3">
                                    <TextBlock Text="DWM GPU Canlı Motor" Foreground="#86EFAC" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                            </DockPanel>

                            <ItemsControl ItemsSource="{Binding ColorPresets}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="2" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="8" Padding="12" Margin="4" BorderThickness="1.3">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#18181B" />
                                                    <Setter Property="BorderBrush" Value="#27272A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                            <Setter Property="Background" Value="#072213" />
                                                            <Setter Property="BorderBrush" Value="#22C55E" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <DockPanel>
                                                <!-- Top Swatches + Spec Badge -->
                                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Swatch1, Mode=OneWay}" Margin="0,0,4,0" />
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Swatch2, Mode=OneWay}" Margin="0,0,4,0" />
                                                        <Ellipse Width="10" Height="10" Fill="{Binding Swatch3, Mode=OneWay}" />
                                                    </StackPanel>
                                                    <Border DockPanel.Dock="Right" HorizontalAlignment="Right" Background="#09090B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="6,2">
                                                        <TextBlock Text="{Binding BadgeText, Mode=OneWay}" Foreground="#D4D4D8" FontSize="9.5" FontWeight="SemiBold" />
                                                    </Border>
                                                </DockPanel>

                                                <!-- Bottom Action Button (Green Active State vs Apply Button) -->
                                                <Button DockPanel.Dock="Bottom" Content="{Binding ActionButtonText, Mode=OneWay}" Margin="0,10,0,0" Padding="10,5" FontSize="11.5"
                                                        HorizontalAlignment="Stretch"
                                                        Command="{Binding DataContext.ApplyColorPresetCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                        CommandParameter="{Binding}">
                                                    <Button.Style>
                                                        <Style TargetType="Button" BasedOn="{StaticResource ShadcnPrimaryBtn}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsActive, Mode=OneWay}" Value="True">
                                                                    <Setter Property="Background" Value="#16A34A" />
                                                                    <Setter Property="Foreground" Value="#FFFFFF" />
                                                                    <Setter Property="BorderBrush" Value="#22C55E" />
                                                                    <Setter Property="FontWeight" Value="Bold" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Button.Style>
                                                </Button>

                                                <!-- Title & Description -->
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Name, Mode=OneWay}" Foreground="#FAFAFA" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Description, Mode=OneWay}" Foreground="#A1A1AA" FontSize="11" TextWrapping="Wrap" Margin="0,4,0,0" />
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <!-- SUB-PANEL 1: HARDWARE DRIVERS & LIVE WINDOWS UPDATE INSTALLER -->
        <Grid x:Name="PanelDriversAudit" Grid.Row="1" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header & Actions -->
            <Border Grid.Row="0" Background="#111113" CornerRadius="8" Padding="15" Margin="0,0,0,10" BorderBrush="#27272A" BorderThickness="1">
                <StackPanel>
                    <DockPanel Margin="0,0,0,10">
                        <StackPanel>
                            <TextBlock Text="Eksik / Eski Sürücü Denetimi &amp; Windows Update Kurulumu" FontSize="16" FontWeight="SemiBold" Foreground="#FAFAFA" />
                            <TextBlock Text="{Binding DriverAuditSummary}" Foreground="#A1A1AA" FontSize="12" Margin="0,4,0,0" TextWrapping="Wrap" />
                        </StackPanel>
                        <ui:ProgressRing IsIndeterminate="True" Width="22" Height="22" DockPanel.Dock="Right" HorizontalAlignment="Right"
                                         Visibility="{Binding IsScanningDrivers, Converter={StaticResource BoolToVis}}" />
                    </DockPanel>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Sürücüleri &amp; Güncellemeleri Tara" Margin="0,0,8,4" Command="{Binding ScanHardwareDriversCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShadcnPrimaryBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDriverOperationBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="⚡ Hazır Sürücüleri Kur (Windows Update)" Margin="0,0,8,4" Command="{Binding InstallPendingDriverUpdatesCommand}">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource ShadcnEmeraldBtn}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDriverOperationBusy}" Value="True">
                                            <Setter Property="IsEnabled" Value="False" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Content="İsteğe Bağlı Sürücü Güncellemeleri" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,8,4" Command="{Binding OpenWindowsOptionalUpdatesCommand}" />
                        <Button Content="Resmi GPU Sürücü Portalı (NVIDIA/AMD/Intel)" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,0,4" Command="{Binding OpenVendorDriverPortalCommand}" />
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- Prominent TOP Live Driver Download & Install Progress Card (%, Speed MB/s, Current Driver, Cancel) -->
            <Border Grid.Row="1" Background="#0A1929" BorderBrush="#1D4ED8" BorderThickness="1.2" CornerRadius="8" Padding="14,12" Margin="0,0,0,10"
                    Visibility="{Binding IsInstallingDrivers, Converter={StaticResource BoolToVis}}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Background="#1E3A8A" BorderBrush="#38BDF8" BorderThickness="1" CornerRadius="5" Padding="8,2" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding DriverInstallPhase}" Foreground="#7DD3FC" FontSize="10.5" FontWeight="Bold" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding DriverInstallCurrentItem}" Foreground="#FAFAFA" FontSize="13" FontWeight="SemiBold"
                                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" />
                        <Border Grid.Column="2" Background="#0F172A" BorderBrush="#334155" BorderThickness="1" CornerRadius="5" Padding="9,3" VerticalAlignment="Center" Margin="0,0,10,0">
                            <TextBlock Text="{Binding DriverInstallSpeedText}" Foreground="#4ADE80" FontSize="12" FontWeight="Bold" />
                        </Border>
                        <TextBlock Grid.Column="3" Text="{Binding DriverInstallPercent, StringFormat={}%{0:F0}}" Foreground="#38BDF8" FontSize="16" FontWeight="Bold"
                                   VerticalAlignment="Center" Margin="0,0,12,0" />
                        <Button Grid.Column="4" Content="İptal Et" Style="{StaticResource ShadcnDangerBtn}" Padding="10,4" FontSize="11"
                                Command="{Binding CancelDriverOperationCommand}" />
                    </Grid>
                    <ProgressBar Value="{Binding DriverInstallPercent, Mode=OneWay}" Maximum="100" Height="8" Foreground="#38BDF8" Background="#1E293B" />
                    <TextBlock Text="{Binding DriverInstallDetailText}" Foreground="#BAE6FD" FontSize="11.5" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- Driver Audit Table with Per-Row Install / Catalog Lookup Actions -->
            <DataGrid Grid.Row="2" ItemsSource="{Binding DriverAuditItems}"
                      AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                      ScrollViewer.HorizontalScrollBarVisibility="Auto"
                      Background="#111113" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                      GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                <DataGrid.Columns>
                    <DataGridTemplateColumn Header="Durum" Width="125">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Border Background="{Binding Severity, Converter={StaticResource SeverityToBgBrush}}"
                                        BorderBrush="{Binding Severity, Converter={StaticResource SeverityToBorderBrush}}"
                                        BorderThickness="1" CornerRadius="6" Padding="7,2" HorizontalAlignment="Left">
                                    <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontSize="10.5" FontWeight="SemiBold" />
                                </Border>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Kategori" Binding="{Binding DeviceClass}" Width="118" />
                    <DataGridTemplateColumn Header="Donanım / Sürücü Adı" Width="225">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding DeviceName}" Foreground="#FAFAFA" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding DeviceName}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Üretici" Binding="{Binding Provider}" Width="112" />
                    <DataGridTextColumn Header="Sürüm" Binding="{Binding CurrentVersion}" Width="110" />
                    <DataGridTemplateColumn Header="Tarih / Boyut" Width="100">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding DriverDateText, Mode=OneWay}" Foreground="#E4E4E7" FontSize="11.5" />
                                    <TextBlock Text="{Binding SizeText, Mode=OneWay}" Foreground="#38BDF8" FontSize="10"
                                               Visibility="{Binding IsPendingWindowsUpdate, Mode=OneWay, Converter={StaticResource BoolToVis}}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="Öneri / Detay" Width="*" MinWidth="170">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Recommendation}" Foreground="#A1A1AA" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Recommendation}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTemplateColumn Header="İşlem" Width="118">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="{Binding ActionLabel}" Padding="9,3" FontSize="11"
                                        Visibility="{Binding HasAction, Converter={StaticResource BoolToVis}}"
                                        Command="{Binding DataContext.HandleDriverItemActionCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource ShadcnSecondaryBtn}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsPendingWindowsUpdate}" Value="True">
                                                    <Setter Property="Background" Value="#052E16" />
                                                    <Setter Property="BorderBrush" Value="#22C55E" />
                                                    <Setter Property="Foreground" Value="#86EFAC" />
                                                    <Setter Property="FontWeight" Value="SemiBold" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>

        <!-- SUB-PANEL 2: UNUSED SERVICES & BACKGROUND BLOAT/RISK AUDIT -->
        <Grid x:Name="PanelServicesBloat" Grid.Row="1" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.25*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- Left: Safe Windows Services Optimizer -->
            <Border Grid.Column="0" Background="#111113" CornerRadius="8" Padding="14" Margin="0,0,8,0" BorderBrush="#27272A" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Kullanılmayan Windows Servisleri (Güvenli &amp; Geri Alınabilir)" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                        <TextBlock Text="{Binding ServiceAuditSummary}" Foreground="#A1A1AA" FontSize="11.5" Margin="0,3,0,8" TextWrapping="Wrap" />
                        <WrapPanel Orientation="Horizontal">
                            <Button Content="Yeniden Tara" Style="{StaticResource ShadcnSecondaryBtn}" Margin="0,0,6,4" Command="{Binding ScanServicesAndBloatCommand}" />
                            <Button Content="⚡ Güvenli Telemetri Servislerini Optimize Et" Style="{StaticResource ShadcnEmeraldBtn}" Margin="0,0,0,4" Command="{Binding OptimizeAllSafeServicesCommand}" />
                        </WrapPanel>
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding UnusedServices}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Durum" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding ImpactSeverity, Converter={StaticResource SeverityToBgBrush}}"
                                                BorderBrush="{Binding ImpactSeverity, Converter={StaticResource SeverityToBorderBrush}}"
                                                BorderThickness="1" CornerRadius="6" Padding="6,2" HorizontalAlignment="Left">
                                            <TextBlock Text="{Binding StatusBadge}" Foreground="{Binding ImpactSeverity, Converter={StaticResource SeverityToBrush}}" FontSize="10" FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Servis" Width="175">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Description}">
                                            <TextBlock Text="{Binding DisplayName}" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding ServiceName}" Foreground="#71717A" FontSize="10" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Açıklama" Width="*" MinWidth="130">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Description}" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Description}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="İşlem" Width="148">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="{Binding ActionText}" Style="{StaticResource ShadcnSecondaryBtn}" Padding="8,3" FontSize="11"
                                                Command="{Binding DataContext.ToggleWindowsServiceCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                CommandParameter="{Binding}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>

            <!-- Right: Running Bloatware & Unsigned/Risky Process Audit -->
            <Border Grid.Column="1" Background="#111113" CornerRadius="8" Padding="14" BorderBrush="#27272A" BorderThickness="1">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,10">
                        <TextBlock Text="Arka Plan Gereksiz &amp; Riskli Süreçler" FontSize="15" FontWeight="SemiBold" Foreground="#FAFAFA" />
                        <TextBlock Text="{Binding BloatAuditSummary}" Foreground="#A1A1AA" FontSize="11.5" Margin="0,3,0,8" TextWrapping="Wrap" />
                        <Button Content="⚡ Gereksizlerin Tümünü Eco Moda Al" Style="{StaticResource ShadcnPrimaryBtn}" HorizontalAlignment="Left"
                                Command="{Binding EcoModeAllBloatProcessesCommand}" />
                    </StackPanel>

                    <DataGrid ItemsSource="{Binding BloatAndRiskyProcesses}"
                              AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              Background="#09090B" Foreground="#E4E4E7" RowBackground="#111113" AlternatingRowBackground="#18181B"
                              GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#27272A" BorderBrush="#27272A" BorderThickness="1">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Süreç" Width="125">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel VerticalAlignment="Center" ToolTip="{Binding Reason}">
                                            <TextBlock Text="{Binding ProcessName}" Foreground="#FAFAFA" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Category}" Foreground="{Binding Severity, Converter={StaticResource SeverityToBrush}}" FontSize="10" FontWeight="SemiBold" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="RAM" Binding="{Binding RamMb, StringFormat={}{0:F0} MB}" Width="72" />
                            <DataGridTemplateColumn Header="Neden" Width="*" MinWidth="110">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Reason}" Foreground="#A1A1AA" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Reason}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="İşlem" Width="118">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Eco" Style="{StaticResource ShadcnSecondaryBtn}" Padding="6,2" FontSize="10.5" Margin="0,0,4,0"
                                                    Command="{Binding DataContext.EcoModeAuditedProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                            <Button Content="Kapat" Style="{StaticResource ShadcnDangerBtn}" Padding="6,2" FontSize="10.5"
                                                    Command="{Binding DataContext.KillAuditedProcessCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
