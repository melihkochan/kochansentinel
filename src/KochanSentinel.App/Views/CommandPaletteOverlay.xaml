<UserControl x:Class="KochanSentinel.App.Views.CommandPaletteOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             Visibility="{Binding IsCommandPaletteOpen, Converter={StaticResource BoolToVis}}"
             IsVisibleChanged="Overlay_IsVisibleChanged">
    <Grid Background="#AA050507" MouseLeftButtonDown="Backdrop_MouseDown">
        <Border Width="620" MaxHeight="470" VerticalAlignment="Top" Margin="0,78,0,0"
                Background="#111113" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="12"
                MouseLeftButtonDown="Card_MouseDown">
            <Border.Effect>
                <DropShadowEffect BlurRadius="32" ShadowDepth="10" Opacity="0.65" Color="#000000" />
            </Border.Effect>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Search Input Bar -->
                <Border Grid.Row="0" BorderBrush="#27272A" BorderThickness="0,0,0,1" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Path Grid.Column="0" Style="{StaticResource ShadcnIconPath}" Data="{StaticResource GeoSearch}"
                              Stroke="#71717A" Width="15" Height="15" Margin="2,0,10,0" />
                        <TextBox x:Name="SearchBox" Grid.Column="1"
                                 Text="{Binding CommandPaletteQuery, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" BorderThickness="0" Foreground="#FAFAFA" CaretBrush="#FAFAFA"
                                 FontSize="14.5" VerticalContentAlignment="Center"
                                 PreviewKeyDown="SearchBox_PreviewKeyDown" />
                        <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1" CornerRadius="5" Padding="7,2" VerticalAlignment="Center">
                            <TextBlock Text="ESC" Foreground="#71717A" FontSize="10" FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>

                <!-- Filtered Action List -->
                <ListBox x:Name="ResultsList" Grid.Row="1"
                         ItemsSource="{Binding FilteredPaletteCommands}"
                         SelectedItem="{Binding SelectedPaletteAction, Mode=TwoWay}"
                         Background="Transparent" BorderThickness="0" Padding="6"
                         MaxHeight="340" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch"
                         MouseDoubleClick="ResultsList_DoubleClick"
                         PreviewMouseLeftButtonUp="ResultsList_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Background="Transparent" CornerRadius="7" Padding="10,8" Margin="0,1" Cursor="Hand">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" Background="#18181B" BorderBrush="#27272A" BorderThickness="1"
                                            CornerRadius="5" Padding="7,2" Margin="0,0,10,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Category}" Foreground="#38BDF8" FontSize="10" FontWeight="SemiBold" />
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Title}" Foreground="#FAFAFA" FontSize="13" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding Subtitle}" Foreground="#A1A1AA" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Border Grid.Column="2" Background="#18181B" BorderBrush="#27272A" BorderThickness="1"
                                            CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="8,0,0,0"
                                            Visibility="{Binding Shortcut, Converter={StaticResource NotNullToVis}}">
                                        <TextBlock Text="{Binding Shortcut}" Foreground="#D4D4D8" FontSize="10.5" FontWeight="Medium" />
                                    </Border>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer Hint -->
                <Border Grid.Row="2" Background="#0C0C0E" BorderBrush="#27272A" BorderThickness="0,1,0,0" CornerRadius="0,0,12,12" Padding="14,8">
                    <DockPanel>
                        <TextBlock Text="↑↓ Seç  •  Enter Çalıştır  •  ESC Kapat" Foreground="#71717A" FontSize="11" />
                        <TextBlock Text="KOCHAN Komut Paleti (Ctrl + K)" Foreground="#52525B" FontSize="11" DockPanel.Dock="Right" HorizontalAlignment="Right" />
                    </DockPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
